generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enums
enum Role {
  BUYER
  SELLER
  ADMIN
}

enum TransactionStatus {
  PENDING_SELLER_ACCEPTANCE
  PENDING_PAYMENT
  PENDING_AGREEMENT
  PENDING_DEPOSIT
  ESCROW_LOCKED
  DISPATCHED
  DELIVERED
  COMPLETED  @map("RELEASED")
  DISPUTE_OPEN @map("DISPUTED")
  REFUNDED
  CANCELLED
}

enum WaybillPayer {
  BUYER
  SELLER
}

enum DisputeFault {
  SELLER_FAULT
  BUYER_FAULT
}

// Admin roles. Prisma-level names are the product spec's (SUPPORT_MODERATOR /
// FINANCE_ADMIN); `@map` keeps persisting the pre-existing DB literals
// (SUPPORT / FINANCE) so this rename performs **zero destructive DDL** on the
// Neon database — no enum type is recreated and no admin loses their role.
enum AdminRole {
  SUPER_ADMIN
  SUPPORT_MODERATOR @map("SUPPORT")
  FINANCE_ADMIN     @map("FINANCE")
}

// ---------------------------------------------------------------------------
// Roadmap: logistics integration. A waybill is booked with one of the
// supported couriers (MOCK is the local/offline provider used while GIGL and
// SPEEDAF credentials are pending).
// ---------------------------------------------------------------------------
enum LogisticsProvider {
  GIGL
  SPEEDAF
  DHL
  CUSTOM
  MOCK
}

// ---------------------------------------------------------------------------
// Roadmap: multi-stage dispute resolution. The stage is orthogonal to the
// transaction status (DISPUTE_OPEN) — it tracks *where* in the moderation
// pipeline a single dispute currently sits.
// ---------------------------------------------------------------------------
enum DisputeStage {
  AWAITING_EVIDENCE
  IN_MEDIATION
  ARBITRATION_PENDING
  RESOLVED
}

// ---------------------------------------------------------------------------
// Roadmap: automated payout queue lifecycle.
// ---------------------------------------------------------------------------
enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

// ---------------------------------------------------------------------------
// Roadmap: fraud risk bands produced by lib/risk/evaluator.ts.
// ---------------------------------------------------------------------------
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

// Models

model User {
  id            String   @id @default(cuid())
  name          String
  phone         String   @unique
  bankCode      String
  accountNumber String
  bankName      String
  role          Role     @default(BUYER)

  // -------------------------------------------------------------------------
  // Administrative access. `password` holds a bcrypt hash (never plaintext)
  // and is only meaningful when role is ADMIN. Both fields are additive so
  // the existing buyer/seller rows are unaffected.
  // -------------------------------------------------------------------------
  adminRole AdminRole @default(SUPPORT_MODERATOR)
  password  String?

  // Trust & verification: payout account name resolved via Flutterwave's
  // Bank Lookup API at onboarding/escrow creation, plus when it was verified.
  bankAccountName String?
  bankVerifiedAt  DateTime?

  // Referral growth hook — short code behind the /r/<code> share link.
  referralCode String? @unique

  createdAt     DateTime @default(now())

  transactionsEscrowed  EscrowTransaction[] @relation("BuyerTransactions")
  transactionsInvolving EscrowTransaction[] @relation("SellerTransactions")
}

model EscrowTransaction {
  id              String   @id @default(cuid())
  transactionRef  String   @unique
  currency        String   @default("NGN")
  countryCode     String   @default("NG")
  paymentProvider String   @default("FLUTTERWAVE")
  
  flwTransactionId String? // Flutterwave transaction id (flwRef) captured at settlement

  // Zero-loss gateway pass-through: Flutterwave processing fees (collection
  // fee at checkout + payout transfer fee) charged on top of the item +
  // platform fee so the seller still receives 100% of their item value.
  gatewayFee Float @default(0)


  itemTitle     String?

  itemAmount    Float
  waybillAmount Float
  totalEscrow   Float
  platformFee   Float

  waybillPayer WaybillPayer

  dispatchStatus String

  courierName  String?
  courierPhone String?

  // -------------------------------------------------------------------------
  // Roadmap: logistics integration. A shipment booked through
  // lib/logistics/* writes the carrier, the carrier's tracking number and a
  // hosted waybill/label URL here; `deliveryStatus` mirrors the carrier's
  // milestone string (PICKED_UP / IN_TRANSIT / OUT_FOR_DELIVERY / DELIVERED).
  // All nullable + additive so existing escrows are untouched.
  // -------------------------------------------------------------------------
  trackingNumber    String?
  logisticsProvider LogisticsProvider?
  waybillUrl        String?
  deliveryStatus    String?

  // Roadmap: multi-stage dispute moderation pipeline (null until a dispute is
  // opened). DisputeStage.ARBITRATION_PENDING escalates to admin arbitration.
  disputeStage DisputeStage?

  // Roadmap: cached fraud risk band. Recomputed by lib/risk/evaluator.ts on
  // lifecycle events; nullable so cold rows resolve risk on demand.
  riskLevel  RiskLevel?
  riskScore  Int?

  status     TransactionStatus @default(PENDING_SELLER_ACCEPTANCE)
  releasePin String            // 4 digits

  autoReleaseAt DateTime?

  termsAcceptedByBuyer Boolean @default(false)

  disputeFault DisputeFault?

  buyerPhone String
  sellerPhone String

  buyerId String
  buyer   User   @relation("BuyerTransactions", fields: [buyerId], references: [id])

  sellerId String
  seller   User   @relation("SellerTransactions", fields: [sellerId], references: [id])

  // Photo/video proof uploaded over WhatsApp after a DISPUTE <ref> command.
  disputeEvidence DisputeEvidence[] @relation("DisputeEvidence")

  // Roadmap: payout queue entries (one escrow can be retried multiple times,
  // so this is a list rather than a single optional relation).
  payouts PayoutQueue[] @relation("EscrowPayouts")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Roadmap: automated payout management.
//
// One row per payout attempt for an escrow release. Keeping attempts as rows
// (rather than mutating a single record) makes the queue auditable: a retry
// increments `retryCount` on a fresh attempt and the failure history survives.
// ---------------------------------------------------------------------------

model PayoutQueue {
  id            String            @id @default(cuid())
  transactionId String
  transaction   EscrowTransaction @relation("EscrowPayouts", fields: [transactionId], references: [id], onDelete: Cascade)
  transactionRef String

  // Stored as Float to match the existing money columns (EscrowTransaction
  // uses Float throughout); the API layer rounds to kobo before calling out.
  amount        Float
  accountNumber String
  bankCode      String

  status       PayoutStatus @default(PENDING)
  retryCount   Int          @default(0)
  errorMessage String?

  // Idempotency: the provider transfer reference minted once per attempt, so a
  // replayed worker run cannot double-pay.
  providerRef String? @unique

  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([transactionId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Roadmap: multi-currency. A tiny rate table for display-time conversion and
// checkout previews. Rates are stored as `1 fromCurrency = rate toCurrency`.
// ---------------------------------------------------------------------------

model CurrencyRate {
  id           String   @id @default(cuid())
  fromCurrency String
  toCurrency   String
  rate         Float
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([fromCurrency, toCurrency])
}

// ---------------------------------------------------------------------------
// Dispute evidence: media proof (photo/video/document) sent over WhatsApp by
// either party after a dispute is opened. Metadata + the Meta media id are
// persisted for the admin dashboard review queue.
// ---------------------------------------------------------------------------

model DisputeEvidence {
  id              String            @id @default(cuid())
  transactionId   String
  transaction     EscrowTransaction @relation("DisputeEvidence", fields: [transactionId], references: [id])
  transactionRef  String
  uploaderPhone   String
  kind            String // IMAGE | VIDEO | DOCUMENT
  whatsappMediaId String
  mimeType        String?
  fileSizeBytes   Int?
  caption         String?
  createdAt       DateTime          @default(now())

  @@index([transactionId])
}

// ---------------------------------------------------------------------------
// WhatsApp conversational bot sessions (bot engine state machine).
//
// One row per messaging phone number. `state` mirrors the bot's flow states
// (IDLE, AWAITING_TITLE, AWAITING_AMOUNT, AWAITING_SELLER_PHONE) and
// `tempData` carries the progressively collected deal fields. Replaces the
// previous in-memory session map so sessions survive serverless restarts and
// are shared across instances.
// ---------------------------------------------------------------------------

model WhatsAppSession {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  state       String   @default("IDLE")
  tempData    Json?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model WebhookLog {
  id        String   @id @default(cuid())
  provider  String
  payload   Json

  // Idempotency key for financial webhook replays: a unique eventId means a
  // replayed event is rejected at insert time (P2002) before any state
  // change, so providers can retry safely forever.
  eventId   String?  @unique

  createdAt DateTime @default(now())
}

model AdminUser {
  id                 String          @id @default(cuid())
  email              String          @unique
  password           String          // Hashed password (bcrypt)
  name               String?
  role               AdminRole       @default(SUPPORT_MODERATOR)
  twoFactorSecret    String?         // TOTP secret for authenticator apps
  isTwoFactorEnabled Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @default(now()) @updatedAt // Added @default(now())
  auditLogs          AdminAuditLog[]
}

model AdminAuditLog {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    String    // e.g. "RELEASE_FUNDS", "UPDATE_WAYBILL", "LOGIN_SUCCESS"
  targetId  String?   // ID of the transaction or resource affected
  details   String?   // JSON string with metadata + changesMade diff
  ipAddress String?   // Request IP address for forensics
  userAgent String?   // Request User-Agent for forensics
  createdAt DateTime  @default(now())
}