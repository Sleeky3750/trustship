generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enums
enum Role {
  BUYER
  SELLER
  ADMIN
}

enum TransactionStatus {
  PENDING_SELLER_ACCEPTANCE
  PENDING_PAYMENT
  PENDING_AGREEMENT
  PENDING_DEPOSIT
  ESCROW_LOCKED
  DISPATCHED
  DELIVERED
  COMPLETED  @map("RELEASED")
  DISPUTE_OPEN @map("DISPUTED")
  REFUNDED
  CANCELLED
}

enum WaybillPayer {
  BUYER
  SELLER
}

enum DisputeFault {
  SELLER_FAULT
  BUYER_FAULT
}

// Admin roles. Prisma-level names are the product spec's (SUPPORT_MODERATOR /
// FINANCE_ADMIN); `@map` keeps persisting the pre-existing DB literals
// (SUPPORT / FINANCE) so this rename performs **zero destructive DDL** on the
// Neon database — no enum type is recreated and no admin loses their role.
enum AdminRole {
  SUPER_ADMIN
  SUPPORT_MODERATOR @map("SUPPORT")
  FINANCE_ADMIN     @map("FINANCE")
}

// ---------------------------------------------------------------------------
// Roadmap: logistics integration. A waybill is booked with one of the
// supported couriers (MOCK is the local/offline provider used while GIGL and
// SPEEDAF credentials are pending).
// ---------------------------------------------------------------------------
enum LogisticsProvider {
  GIGL
  SPEEDAF
  DHL
  CUSTOM
  MOCK
}

// ---------------------------------------------------------------------------
// Roadmap: multi-stage dispute resolution. The stage is orthogonal to the
// transaction status (DISPUTE_OPEN) — it tracks *where* in the moderation
// pipeline a single dispute currently sits.
// ---------------------------------------------------------------------------
enum DisputeStage {
  AWAITING_EVIDENCE
  IN_MEDIATION
  ARBITRATION_PENDING
  RESOLVED
}

// ---------------------------------------------------------------------------
// Roadmap: automated payout queue lifecycle.
// ---------------------------------------------------------------------------
enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

// ---------------------------------------------------------------------------
// Roadmap: fraud risk bands produced by lib/risk/evaluator.ts.
// ---------------------------------------------------------------------------
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

// ---------------------------------------------------------------------------
// Refund lifecycle. A refund moves money OUT of escrow back to the buyer, so
// it is an explicit multi-step workflow rather than a single status flip:
// a request is recorded, reviewed and approved before any provider call, and
// is only COMPLETED once the payment provider confirms it. This replaces the
// legacy behaviour where `escrow/ref` flipped the escrow to REFUNDED and told
// the customer the money was on its way without ever calling Flutterwave.
// ---------------------------------------------------------------------------
enum RefundStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

// ---------------------------------------------------------------------------
// Multi-stage dispute case. The stage pipeline lives in
// lib/disputes/transitions.ts and is orthogonal to TransactionStatus.
// ---------------------------------------------------------------------------
enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  AWAITING_BUYER
  AWAITING_SELLER
  ESCALATED
  RESOLVED
  CLOSED
}

// Models

model User {
  id            String   @id @default(cuid())
  name          String
  phone         String   @unique
  bankCode      String
  accountNumber String
  bankName      String
  role          Role     @default(BUYER)

  // -------------------------------------------------------------------------
  // Administrative access. `password` holds a bcrypt hash (never plaintext)
  // and is only meaningful when role is ADMIN. Both fields are additive so
  // the existing buyer/seller rows are unaffected.
  // -------------------------------------------------------------------------
  adminRole AdminRole @default(SUPPORT_MODERATOR)
  password  String?

  // Trust & verification: payout account name resolved via Flutterwave's
  // Bank Lookup API at onboarding/escrow creation, plus when it was verified.
  bankAccountName String?
  bankVerifiedAt  DateTime?

  // Referral growth hook — short code behind the /r/<code> share link.
  referralCode String? @unique

  createdAt     DateTime @default(now())

  transactionsEscrowed  EscrowTransaction[] @relation("BuyerTransactions")
  transactionsInvolving EscrowTransaction[] @relation("SellerTransactions")
}

model EscrowTransaction {
  id              String   @id @default(cuid())
  transactionRef  String   @unique
  currency        String   @default("NGN")
  countryCode     String   @default("NG")
  paymentProvider String   @default("FLUTTERWAVE")
  
  flwTransactionId String? // Flutterwave transaction id (flwRef) captured at settlement

  // Zero-loss gateway pass-through: Flutterwave processing fees (collection
  // fee at checkout + payout transfer fee) charged on top of the item +
  // platform fee so the seller still receives 100% of their item value.
  gatewayFee Float @default(0)


  itemTitle     String?

  itemAmount    Float
  waybillAmount Float
  totalEscrow   Float
  platformFee   Float

  waybillPayer WaybillPayer

  dispatchStatus String

  courierName  String?
  courierPhone String?

  // -------------------------------------------------------------------------
  // Roadmap: logistics integration. A shipment booked through
  // lib/logistics/* writes the carrier, the carrier's tracking number and a
  // hosted waybill/label URL here; `deliveryStatus` mirrors the carrier's
  // milestone string (PICKED_UP / IN_TRANSIT / OUT_FOR_DELIVERY / DELIVERED).
  // All nullable + additive so existing escrows are untouched.
  // -------------------------------------------------------------------------
  trackingNumber    String?
  logisticsProvider LogisticsProvider?
  waybillUrl        String?
  deliveryStatus    String?

  // Roadmap: multi-stage dispute moderation pipeline (null until a dispute is
  // opened). DisputeStage.ARBITRATION_PENDING escalates to admin arbitration.
  disputeStage DisputeStage?

  // Roadmap: cached fraud risk band. Recomputed by lib/risk/evaluator.ts on
  // lifecycle events; nullable so cold rows resolve risk on demand.
  riskLevel  RiskLevel?
  riskScore  Int?

  status     TransactionStatus @default(PENDING_SELLER_ACCEPTANCE)
  releasePin String            // 4 digits

  autoReleaseAt DateTime?

  termsAcceptedByBuyer Boolean @default(false)

  disputeFault DisputeFault?

  buyerPhone String
  sellerPhone String

  buyerId String
  buyer   User   @relation("BuyerTransactions", fields: [buyerId], references: [id])

  sellerId String
  seller   User   @relation("SellerTransactions", fields: [sellerId], references: [id])

  // Photo/video proof uploaded over WhatsApp after a DISPUTE <ref> command.
  disputeEvidence DisputeEvidence[] @relation("DisputeEvidence")

  // Roadmap: payout queue entries (one escrow can be retried multiple times,
  // so this is a list rather than a single optional relation).
  payouts PayoutQueue[] @relation("EscrowPayouts")

  // Refund workflow records for this escrow (multiple rejected/retried
  // attempts are kept for auditability).
  refunds Refund[] @relation("EscrowRefunds")

  // Append-only lifecycle event log powering the admin transaction timeline.
  events TransactionEvent[] @relation("EscrowEvents")

  // Dispute cases raised against this escrow.
  disputes Dispute[] @relation("EscrowDisputes")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Refund workflow.
//
// One row per refund *request*. Money only moves when the row reaches
// PROCESSING and the provider confirms it (COMPLETED). All monetary columns use
// integer minor units (kobo) for new models so there is no float drift — the
// legacy EscrowTransaction Float columns are left untouched (converting them
// would be a destructive migration).
// ---------------------------------------------------------------------------

model Refund {
  id            String            @id @default(cuid())
  transactionId String
  transaction   EscrowTransaction @relation("EscrowRefunds", fields: [transactionId], references: [id], onDelete: Cascade)
  transactionRef String

  /// Refund amount in integer minor units (kobo for NGN).
  amountMinor   Int
  currency      String   @default("NGN")

  reason        String?
  status        RefundStatus @default(REQUESTED)

  /// Administrator (AdminUser id) who created the request.
  requestedById String?
  /// Administrator who approved/rejected it.
  reviewedById  String?

  /// Provider-side refund reference, minted once per execution attempt.
  processorRef  String? @unique
  failureReason String?

  reviewedAt    DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([transactionId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Append-only escrow lifecycle event log. Every real state change appends a
// row; the admin timeline renders ONLY these rows (never synthesised events),
// satisfying "only display events that actually occurred".
// ---------------------------------------------------------------------------

model TransactionEvent {
  id            String            @id @default(cuid())
  transactionId String
  transaction   EscrowTransaction @relation("EscrowEvents", fields: [transactionId], references: [id], onDelete: Cascade)
  transactionRef String

  /// Machine event type, e.g. ESCROW_CREATED / PAYMENT_VERIFIED / DISPUTE_OPENED.
  type          String
  /// Human-readable summary shown in the timeline.
  message       String?
  /// Structured metadata (statuses, amounts, references) — no secrets.
  metadata      Json?

  /// Who/what produced the event: ADMIN | SYSTEM | WEBHOOK | BUYER | SELLER.
  actorKind     String  @default("SYSTEM")
  actorId       String?

  createdAt     DateTime @default(now())

  @@index([transactionId])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Dispute case. Carries the moderation metadata (assignee, category, status
// history summary) that the thin `disputeFault` column on the escrow cannot.
// ---------------------------------------------------------------------------

model Dispute {
  id            String            @id @default(cuid())
  transactionId String
  transaction   EscrowTransaction @relation("EscrowDisputes", fields: [transactionId], references: [id], onDelete: Cascade)
  transactionRef String

  category      String?
  description   String?
  status        DisputeStatus @default(OPEN)
  /// AdminUser id of the moderator assigned to the case.
  assignedToId  String?
  resolution    String?

  openedByPhone String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([transactionId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Customer-support scripts. Internal, customer-facing message templates with
// {{placeholder}} substitution. `isInternal` distinguishes agent-only notes
// from copy-pasteable customer text so internal notes can never be sent.
// ---------------------------------------------------------------------------

model SupportScript {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String   @default("General")
  /// The customer-facing (or internal) body, containing {{placeholders}}.
  body        String
  /// Usage guidance shown to agents.
  usageNotes  String?
  isInternal  Boolean  @default(false)
  isActive    Boolean  @default(true)

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions SupportScriptVersion[]

  @@index([category])
}

// ---------------------------------------------------------------------------
// Immutable-ish edit history for support scripts. One row appended per edit so
// a script's wording is reconstructible after the fact.
// ---------------------------------------------------------------------------

model SupportScriptVersion {
  id        String        @id @default(cuid())
  scriptId  String
  script    SupportScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  body      String
  title     String
  editedById String?
  createdAt DateTime  @default(now())

  @@index([scriptId])
}

// ---------------------------------------------------------------------------
// Roadmap: automated payout management.
//
// One row per payout attempt for an escrow release. Keeping attempts as rows
// (rather than mutating a single record) makes the queue auditable: a retry
// increments `retryCount` on a fresh attempt and the failure history survives.
// ---------------------------------------------------------------------------

model PayoutQueue {
  id            String            @id @default(cuid())
  transactionId String
  transaction   EscrowTransaction @relation("EscrowPayouts", fields: [transactionId], references: [id], onDelete: Cascade)
  transactionRef String

  // Stored as Float to match the existing money columns (EscrowTransaction
  // uses Float throughout); the API layer rounds to kobo before calling out.
  amount        Float
  accountNumber String
  bankCode      String

  status       PayoutStatus @default(PENDING)
  retryCount   Int          @default(0)
  errorMessage String?

  // Idempotency: the provider transfer reference minted once per attempt, so a
  // replayed worker run cannot double-pay.
  providerRef String? @unique

  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([transactionId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Roadmap: multi-currency. A tiny rate table for display-time conversion and
// checkout previews. Rates are stored as `1 fromCurrency = rate toCurrency`.
// ---------------------------------------------------------------------------

model CurrencyRate {
  id           String   @id @default(cuid())
  fromCurrency String
  toCurrency   String
  rate         Float
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([fromCurrency, toCurrency])
}

// ---------------------------------------------------------------------------
// Dispute evidence: media proof (photo/video/document) sent over WhatsApp by
// either party after a dispute is opened. Metadata + the Meta media id are
// persisted for the admin dashboard review queue.
// ---------------------------------------------------------------------------

model DisputeEvidence {
  id              String            @id @default(cuid())
  transactionId   String
  transaction     EscrowTransaction @relation("DisputeEvidence", fields: [transactionId], references: [id])
  transactionRef  String
  uploaderPhone   String
  kind            String // IMAGE | VIDEO | DOCUMENT
  whatsappMediaId String
  mimeType        String?
  fileSizeBytes   Int?
  caption         String?
  createdAt       DateTime          @default(now())

  @@index([transactionId])
}

// ---------------------------------------------------------------------------
// WhatsApp conversational bot sessions (bot engine state machine).
//
// One row per messaging phone number. `state` mirrors the bot's flow states
// (IDLE, AWAITING_TITLE, AWAITING_AMOUNT, AWAITING_SELLER_PHONE) and
// `tempData` carries the progressively collected deal fields. Replaces the
// previous in-memory session map so sessions survive serverless restarts and
// are shared across instances.
// ---------------------------------------------------------------------------

model WhatsAppSession {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  state       String   @default("IDLE")
  tempData    Json?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model WebhookLog {
  id        String   @id @default(cuid())
  provider  String
  payload   Json

  // Idempotency key for financial webhook replays: a unique eventId means a
  // replayed event is rejected at insert time (P2002) before any state
  // change, so providers can retry safely forever.
  eventId   String?  @unique

  // -------------------------------------------------------------------------
  // Processing metadata (added for the admin webhook-history view). These are
  // additive + nullable so the existing rows and the idempotency insert path
  // are unaffected.
  // -------------------------------------------------------------------------
  /// Provider event type, e.g. "charge.completed".
  eventType      String?
  /// Related escrow reference, when resolvable.
  transactionRef String?
  /// PROCESSING | PROCESSED | FAILED (best-effort; the row survives either way).
  status         String   @default("PROCESSED")
  /// How many delivery attempts have been observed for this eventId.
  attemptCount   Int      @default(1)
  /// Coarse error category when status is FAILED (never a raw stack trace).
  errorCategory  String?
  processedAt    DateTime?
  updatedAt      DateTime @default(now()) @updatedAt

  createdAt DateTime @default(now())

  @@index([provider])
  @@index([transactionRef])
}

model AdminUser {
  id                 String          @id @default(cuid())
  email              String          @unique
  password           String          // Hashed password (bcrypt)
  name               String?
  role               AdminRole       @default(SUPPORT_MODERATOR)
  twoFactorSecret    String?         // TOTP secret for authenticator apps
  isTwoFactorEnabled Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @default(now()) @updatedAt // Added @default(now())
  auditLogs          AdminAuditLog[]
}

model AdminAuditLog {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    String    // e.g. "RELEASE_FUNDS", "UPDATE_WAYBILL", "LOGIN_SUCCESS"
  targetId  String?   // ID of the transaction or resource affected
  details   String?   // JSON string with metadata + changesMade diff
  ipAddress String?   // Request IP address for forensics
  userAgent String?   // Request User-Agent for forensics
  createdAt DateTime  @default(now())

  // -------------------------------------------------------------------------
  // Forensic metadata (additive). Role is stored *as of the action* so a later
  // role change cannot rewrite history; correlationId groups the actions of a
  // single request/incident; outcome records success vs failure.
  // -------------------------------------------------------------------------
  actorRole     String?
  correlationId String?
  outcome       String  @default("SUCCESS")
  reason        String?

  @@index([adminId])
  @@index([action])
  @@index([correlationId])
}