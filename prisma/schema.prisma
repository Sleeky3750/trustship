generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enums
enum Role {
  BUYER
  SELLER
  ADMIN
}

enum TransactionStatus {
  PENDING_SELLER_ACCEPTANCE
  PENDING_PAYMENT
  PENDING_AGREEMENT
  PENDING_DEPOSIT
  ESCROW_LOCKED
  DISPATCHED
  DELIVERED
  RELEASED
  DISPUTED
  REFUNDED
  CANCELLED
}

enum WaybillPayer {
  BUYER
  SELLER
}

enum DisputeFault {
  SELLER_FAULT
  BUYER_FAULT
}

enum AdminRole {
  SUPER_ADMIN
  FINANCE
  SUPPORT
}

// Models

model User {
  id            String   @id @default(cuid())
  name          String
  phone         String   @unique
  bankCode      String
  accountNumber String
  bankName      String
  role          Role     @default(BUYER)
  createdAt     DateTime @default(now())

  transactionsEscrowed  EscrowTransaction[] @relation("BuyerTransactions")
  transactionsInvolving EscrowTransaction[] @relation("SellerTransactions")
}

model EscrowTransaction {
  id              String   @id @default(cuid())
  transactionRef  String   @unique
  currency        String   @default("NGN")
  countryCode     String   @default("NG")
  paymentProvider String   @default("FLUTTERWAVE")
  
  flwTransactionId String?

  // Paystack settlement reference (WhatsApp-first flow). Set when the seller
  // accepts and the Paystack transaction is initialized; the Paystack webhook
  // resolves charge events against transactionRef/paystackRef.
  paystackRef String?


  itemTitle     String?

  itemAmount    Float
  waybillAmount Float
  totalEscrow   Float
  platformFee   Float

  waybillPayer WaybillPayer

  dispatchStatus String

  courierName  String?
  courierPhone String?

  status     TransactionStatus @default(PENDING_SELLER_ACCEPTANCE)
  releasePin String            // 4 digits

  autoReleaseAt DateTime?

  termsAcceptedByBuyer Boolean @default(false)

  disputeFault DisputeFault?

  buyerPhone String
  sellerPhone String

  buyerId String
  buyer   User   @relation("BuyerTransactions", fields: [buyerId], references: [id])

  sellerId String
  seller   User   @relation("SellerTransactions", fields: [sellerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// WhatsApp conversational bot sessions (bot engine state machine).
//
// One row per messaging phone number. `state` mirrors the bot's flow states
// (IDLE, AWAITING_TITLE, AWAITING_AMOUNT, AWAITING_SELLER_PHONE) and
// `tempData` carries the progressively collected deal fields. Replaces the
// previous in-memory session map so sessions survive serverless restarts and
// are shared across instances.
// ---------------------------------------------------------------------------

model WhatsAppSession {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  state       String   @default("IDLE")
  tempData    Json?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model WebhookLog {
  id        String   @id @default(cuid())
  provider  String
  payload   Json
  createdAt DateTime @default(now())
}

model AdminUser {
  id                 String          @id @default(cuid())
  email              String          @unique
  password           String          // Hashed password
  name               String?
  role               AdminRole       @default(SUPPORT)
  twoFactorSecret    String?         // TOTP secret for authenticator apps
  isTwoFactorEnabled Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @default(now()) @updatedAt // Added @default(now())
  auditLogs          AdminAuditLog[]
}

model AdminAuditLog {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    String    // e.g. "RELEASE_FUNDS", "UPDATE_WAYBILL", "LOGIN_SUCCESS"
  targetId  String?   // ID of the transaction or resource affected
  details   String?   // JSON string with metadata + changesMade diff
  ipAddress String?   // Request IP address for forensics
  userAgent String?   // Request User-Agent for forensics
  createdAt DateTime  @default(now())
}