generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enums
enum Role {
  BUYER
  SELLER
  ADMIN
}

enum TransactionStatus {
  PENDING_AGREEMENT
  PENDING_DEPOSIT
  ESCROW_LOCKED
  DISPATCHED
  DELIVERED
  RELEASED
  DISPUTED
  REFUNDED
}

enum WaybillPayer {
  BUYER
  SELLER
}

enum DisputeFault {
  SELLER_FAULT
  BUYER_FAULT
}

// Models

model User {
  id          String   @id @default(cuid())
  name        String
  phone       String   @unique
  bankCode    String
  accountNumber String
  bankName    String
  role        Role     @default(BUYER)
  createdAt   DateTime @default(now())

  transactionsEscrowed   EscrowTransaction[]  @relation("BuyerTransactions")
  transactionsInvolving   EscrowTransaction[] @relation("SellerTransactions")
}

model EscrowTransaction {
  id               String   @id @default(cuid())
  transactionRef   String   @unique
  currency         String   @default("NGN")
  countryCode      String   @default("NG")
  paymentProvider  String   @default("PAYSTACK")

  itemAmount       Float
  waybillAmount    Float
  totalEscrow      Float
  platformFee      Float

  waybillPayer     WaybillPayer

  dispatchStatus   String

  courierName      String?
  courierPhone     String?

  status           TransactionStatus
  releasePin       String   // 4 digits

  autoReleaseAt    DateTime?

  termsAcceptedByBuyer Boolean  @default(false)

  disputeFault     DisputeFault?

  buyerPhone       String
  sellerPhone      String

  buyerId          String
  buyer            User    @relation("BuyerTransactions", fields: [buyerId], references: [id])

  sellerId         String
  seller           User    @relation("SellerTransactions", fields: [sellerId], references: [id])
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model WebhookLog {
  id        String   @id @default(cuid())
  provider   String
  payload    Json
  createdAt  DateTime @default(now())
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // Hashed password
  name      String?
  createdAt DateTime @default(now())
}