# --- Database (Neon or any Postgres) ---
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# --- Admin session signing (must be identical across proxy.ts, login, requireAdmin) ---
JWT_SECRET="change-me-to-a-long-random-secret"

# --- App URLs ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_EMAIL="trustship.app@gmail.com"

# --- Flutterwave v3 ---
FLUTTERWAVE_SECRET_KEY="FLWSECK-..."
FLUTTERWAVE_WEBHOOK_SECRET_HASH="your-webhook-verif-hash"

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_ACCESS_TOKEN="your_whatsapp_business_token"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your_webhook_verify_token"
# App secret for x-hub-signature-256 webhook verification (required in production)
WHATSAPP_APP_SECRET="your_meta_app_secret"


# --- Cron auth: required by GET /api/cron/auto-release and /api/cron/cleanup-sessions ---
# Send as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="generate-with-openssl-rand-hex-32"
