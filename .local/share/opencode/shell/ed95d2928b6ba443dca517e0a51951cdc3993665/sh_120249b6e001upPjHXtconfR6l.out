            <th className="py-4 text-right actions">Actions</th>
          </tr>
        </thead>
        <tbody>
          {products.map((product) => {
            const isEditing = editing?.id === product.id;
            return (
              <tr
                key={product.id}
                className={`hover:bg-zinc-900/30 transition-colors ${isEditing ? "bg-zinc-900/50" : ""}`}
              >
                <td className="py-6 px-4">
                  {isEditing ? (
                    <input
                      type="text"
                      value={product.imageUrl || ""}
                      onChange={(e) =>
                        setEditing((prev) => ({ ...prev, imageUrl: e.target.value }))
                      }
                      className="w-full bg-zinc-900 border border-zinc-700 rounded-lg px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-indigo-500/60"
                    />
                  ) : (
                    <img
                      src={product.imageUrl || "/placeholder-product.svg"}
                      alt={product.name}
                      className="w-10 h-10 rounded-lg object-cover"
