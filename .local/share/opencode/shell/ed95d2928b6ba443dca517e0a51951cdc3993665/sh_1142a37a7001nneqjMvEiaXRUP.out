"use client";

import { useState } from "react";

import type { AiIntent } from "@/lib/ai/schemas/requests";
import type { AiResponse } from "@/lib/ai/schemas/responses";

import AiActionConfirmation from "./AiActionConfirmation";

const intentLabels: Record<AiIntent, string> = {
  assistant: "Ask Pulse",
  insights: "Business insights",
  progress: "Analyze progress",
  priorities: "Today's priorities",
  plan: "Generate a plan",
};

export default function PulseAiPanel({
  scope,
}: {
  scope?: { workspaceId?: string; projectId?: string };
}) {
  const [intent, setIntent] = useState<AiIntent>("assistant");
  const [message, setMessage] = useState("");
  const [response, setResponse] = useState<AiResponse | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  const needsMessage = intent === "assistant" || intent === "plan";

  async function runAi() {
    if (needsMessage && !message.trim()) {
      setError(
        intent === "plan"
          ? "Describe the objective you want Pulse to plan."
          : "Ask Pulse a question first."
      );
      return;
    }

    setLoading(true);
    setError("");

    try {
      const request = {
        intent,
        ...(needsMessage ? { message: message.trim() } : {}),
        ...(scope ? { scope } : {}),
      };
      const apiResponse = await fetch("/api/ai", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(request),
      });
      const data = await apiResponse.json();

      if (!apiResponse.ok || !data.success) {
        throw new Error(data.message || "Pulse AI could not complete that request.");
      }

