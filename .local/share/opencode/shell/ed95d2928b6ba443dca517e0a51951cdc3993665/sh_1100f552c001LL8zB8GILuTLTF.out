import { NextResponse } from "next/server";

import { getCurrentBusiness } from "@/lib/auth/business";
import {
  AiAuthenticationError,
  AiValidationError,
  toAiErrorResponse,
} from "@/lib/ai/core/errors";
import { aiRequestSchema } from "@/lib/ai/schemas/requests";
import { answerAssistant } from "@/lib/ai/services/assistant";
import { generateInsights } from "@/lib/ai/services/insights";
import { generatePlan } from "@/lib/ai/services/planning";
import { recommendPriorities } from "@/lib/ai/services/priorities";
import { analyzeProgress } from "@/lib/ai/services/progress";

export async function POST(request: Request) {
  try {
    const business = await getCurrentBusiness();

    if (!business) {
      throw new AiAuthenticationError();
    }

    const body = await request.json().catch(() => {
      throw new AiValidationError("The request body must be valid JSON.");
    });
    const parsed = aiRequestSchema.safeParse(body);

    if (!parsed.success) {
      throw new AiValidationError();
    }

    const requestData = parsed.data;
    let response;

    switch (requestData.intent) {
      case "assistant":
        if (!requestData.message) {
          throw new AiValidationError("A question is required for the assistant.");
        }
        response = await answerAssistant({
          businessId: business.id,
          scope: requestData.scope,
          message: requestData.message,
        });
        break;
      case "plan":
        if (!requestData.message) {
          throw new AiValidationError("An objective is required to generate a plan.");
        }
        response = await generatePlan({
          businessId: business.id,
          scope: requestData.scope,
          objective: requestData.message,
        });
        break;
      case "progress":
        response = await analyzeProgress({
          businessId: business.id,
          scope: requestData.scope,

