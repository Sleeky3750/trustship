import "server-only";

import { AiProviderError } from "./errors";

const GROQ_API_URL = "https://api.groq.com/openai/v1/chat/completions";
const GROQ_MODEL = process.env.GROQ_MODEL ?? "llama-3.3-70b-versatile";
const REQUEST_TIMEOUT_MS = 20_000;

export interface AiProviderMessage {
  role: "system" | "user";
  content: string;
}

interface GroqResponse {
  choices?: Array<{
    message?: {
      content?: string | null;
    };
  }>;
}

export async function completeWithGroq({
  messages,
  maxTokens,
  jsonMode = false,
}: {
  messages: AiProviderMessage[];
  maxTokens: number;
  jsonMode?: boolean;
}): Promise<string> {
  const apiKey = process.env.GROQ_API_KEY;

  if (!apiKey) {
    throw new AiProviderError("AI is not configured on this server.");
  }

  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), REQUEST_TIMEOUT_MS);

  try {
    const response = await fetch(GROQ_API_URL, {
      method: "POST",
      headers: {
        Authorization: `Bearer ${apiKey}`,
        "Content-Type": "application/json",
      },
      body: JSON.stringify({
        model: GROQ_MODEL,
        messages,
        max_tokens: maxTokens,
        temperature: 0.2,
        ...(jsonMode ? { response_format: { type: "json_object" } } : {}),
      }),
      signal: controller.signal,
    });

    if (!response.ok) {
      console.error("Groq request failed:", response.status);
      throw new AiProviderError();
    }

==> lib/auth/business.ts <==
import { cookies } from "next/headers";
import { prisma } from "@/lib/prisma";
import {
  COOKIE_NAME,
  verifySessionValue,
} from "@/lib/auth/session";

export async function getCurrentBusiness() {
  const cookieStore = await cookies();

  const businessId = verifySessionValue(
    cookieStore.get(COOKIE_NAME)?.value
  );

  if (!businessId) {
    return null;
  }

  return prisma.business.findUnique({
    where: {
      id: businessId,
    },
  });
}
