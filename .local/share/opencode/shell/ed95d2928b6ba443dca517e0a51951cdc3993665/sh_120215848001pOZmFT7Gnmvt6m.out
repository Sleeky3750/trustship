                </td>
                <td className="py-6 px-4 text-center">
                  {isEditing ? (
                    <select
                      value={product.inStock ? "in-stock" : "out-of-stock"}
                      onChange={(e) =>
                        setEditing((prev) => ({
                          ...prev,
                          inStock: e.target.value === "in-stock",
                        }))
                      }
                      className="w-full bg-zinc-900 border border-zinc-700 rounded-lg px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-indigo-500/60"
                    >
                      <option value="in-stock">In Stock</option>
                      <option value="out-of-stock">Out of Stock</option>
                    </select>
                  ) : (
                    <span className="px-2 py-1 rounded text-xs ${product.inStock ? "text-zinc-900 bg-emerald-100" : "text-zinc-900 bg-amber-100"}">
                      {product.inStock ? "In Stock" : "Out of Stock"}
                    </span>
                  )}
                </td>
                <td className="py-6 px-4 actions">
                  <button
                    onClick={() => handleEdit(product)}
                    className="mr-2 rounded-lg border border-zinc-700 bg-zinc-950/50 px-3 py-2 text-sm text-zinc-400 hover:bg-zinc-900 transition-colors"
                    aria-label="Edit product"
                  >
                    Edit
                  </button>
                  <button
                    onClick={() => handleDelete(product.id)}
                    className="rounded-lg border border-zinc-700 bg-zinc-950/50 px-3 py-2 text-sm text-zinc-400 hover:bg-zinc-900 transition-colors"
                    aria-label="Delete product"
                  >
                    Delete
                  </button>
                </td>
              </tr>
            );
          })}
          {campaigns.length === 0 && (
            <tr>
              <td colSpan={7} className="p-8 text-center text-zinc-500">
                No campaigns yet.
                <button
                  className="rounded-lg border border-zinc-700 bg-zinc-950/50 px-2 py-1 text-sm text-zinc-400 hover:bg-zinc-900"
                >
                  Create your first broadcast
                </button>
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  );
}
