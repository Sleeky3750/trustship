                )}
              </div>
            </div>
          </div>

          <dl className="grid grid-cols-3 gap-2">
            <Stat label="Messages" value={customer.totalMessages} />
            <Stat label="Inbound" value={customer.inboundMessages} />
            <Stat label="Outbound" value={customer.outboundMessages} />
          </dl>

          <div className="mt-4 space-y-3">
            <div className="flex items-center gap-2">
              <dt className="text-zinc-500">Tags</dt>
              <div className="flex gap-1">{tagBadges}</div>
            </div>
