models.ts
export type TaskStatus =
  | "TODO"
  | "IN_PROGRESS"
  | "DONE";

export type TaskPriority =
  | "LOW"
  | "MEDIUM"
  | "HIGH";

export interface Task {
  id: string;
  title: string;
  description: string | null;

  status: TaskStatus;
  priority: TaskPriority;

  dueDate: Date | null;

