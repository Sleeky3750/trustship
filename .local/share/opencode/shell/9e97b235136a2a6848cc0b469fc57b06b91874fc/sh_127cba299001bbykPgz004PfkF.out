{
  "name": "trustship",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db": "prisma generate && prisma migrate deploy",
    "db:push": "prisma migrate resolve --applied && prisma migrate save --preview-feature"
  },
