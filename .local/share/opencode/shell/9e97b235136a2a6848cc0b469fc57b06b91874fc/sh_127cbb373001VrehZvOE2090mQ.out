import { NextRequest, NextResponse } from "next/server"
import { prisma } from "@/lib/prisma"

// POST - Paystack webhook handler
export async function POST(request: NextRequest) {
  try {
    const body = await request.json()
    const { event, data } = body

    // Log the webhook event
    await prisma.webhookLog.create({
      data: {
        provider: "PAYSTACK",
        payload: body,
      },
    })

    // Handle different event types
    switch (event) {
      case "charge.success": {
        const {
          reference,
          amount,
          status,
          metadata,
        } = data

        // Process successful payment
        if (status === "success" && metadata) {
          const { transactionRef, escrowId } = metadata

          // Update escrow transaction status
          await prisma.escrowTransaction.update({
            where: { transactionRef },
            data: {
              status: "ESCROW_LOCKED",
              // Could update payment status here
            },
          })
        }
        break
      }

      case "transfer.reversed": {
        // Handle payment reversal
        const {
          reference,
          metadata,
        } = data

        if (metadata?.transactionRef) {
          await prisma.escrowTransaction.update({
            where: { transactionRef: metadata.transactionRef },
            data: {
              status: "REFUNDED",
            },
          })
        }
        break
      }

      default:
        // Unhandled event type
        break
    }

    return NextResponse.json({ received: true }, { status: 200 })
  } catch (error) {
    console.error("Paystack webhook error:", error)
    return NextResponse.json(
      { error: "Webhook processing failed" },
      { status: 500 }
    )
  }
}