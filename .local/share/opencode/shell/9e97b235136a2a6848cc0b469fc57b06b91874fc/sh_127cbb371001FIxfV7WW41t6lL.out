import { NextRequest, NextResponse } from "next/server"
import { prisma } from "@/lib/prisma"
import axios from "axios"

// POST - Escrow contract creation logic
export async function POST(request: NextRequest) {
  try {
    const body = await request.json()
    const {
      transactionRef,
      currency,
      countryCode,
      paymentProvider,
      itemAmount,
      waybillAmount,
      totalEscrow,
      platformFee,
      waybillPayer,
      dispatchStatus,
      courierName,
      courierPhone,
      status,
      releasePin,
      autoReleaseAt,
      termsAcceptedByBuyer,
      disputeFault,
      buyerPhone,
      sellerPhone,
    } = body

    // Validate required fields
    if (!transactionRef || !itemAmount || !waybillAmount || !totalEscrow) {
      return NextResponse.json(
        { error: "Missing required fields: transactionRef, itemAmount, waybillAmount, totalEscrow" },
        { status: 400 }
      )
    }

    // Create escrow transaction
    const transaction = await prisma.escrowTransaction.create({
      data: {
        transactionRef,
        currency: currency || "NGN",
        countryCode: countryCode || "NG",
        paymentProvider: paymentProvider || "PAYSTACK",
        itemAmount,
        waybillAmount,
        totalEscrow,
        platformFee: platformFee || 0,
        waybillPayer: waybillPayer || "BUYER",
        dispatchStatus: dispatchStatus || "PENDING",
        courierName,
        courierPhone,
        status: status || "PENDING_AGREEMENT",
        releasePin: releasePin || "0000",
        autoReleaseAt: autoReleaseAt ? new Date(autoReleaseAt) : undefined,
        termsAcceptedByBuyer: termsAcceptedByBuyer || false,
        disputeFault: disputeFault ?? null,
        buyerPhone,
        sellerPhone,
      },
    })

    return NextResponse.json(
      { success: true, data: transaction },
      { status: 201 }
    )
  } catch (error) {
    console.error("Escrow creation error:", error)
    return NextResponse.json(
      { error: "Failed to create escrow transaction" },
      { status: 500 }
    )
  }
}