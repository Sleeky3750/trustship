timestamp=2026-10-07T04:24:10.728Z level=INFO run=9ad1a2a0 message="spawning process" command=/bin/bash args="[\"-c\",\"python3 - <<'EOF'\\np='app/api/webhooks/whatsapp/route.ts'\\ns=open(p).read()\\ndef rep(old,new):\\n    global s\\n    assert s.count(old)==1, old[:60]\\n    s=s.replace(old,new)\\nrep('''import { NextRequest, NextResponse, after } from \\\"next/server\\\";''','''import { timingSafeEqual } from \\\"node:crypto\\\";\\nimport { NextRequest, NextResponse, after } from \\\"next/server\\\";''')\\nrep('''import { logWhatsAppEvent, maskPhone } from \\\"@/lib/whatsapp/events\\\";''','''import { logWhatsAppEvent, maskPhone } from \\\"@/lib/whatsapp/events\\\";\\nimport { verifyMetaSignature } from \\\"@/lib/whatsapp/signature\\\";\\nimport { loadAiStaffConfig } from \\\"@/lib/ai/staffConfig\\\";''')\\nrep('''  if (mode === \\\"subscribe\\\" && token === expectedToken && challenge) {\\n    return new Response(challenge, {\\n      status: 200,\\n      headers: { \\\"Content-Type\\\": \\\"text/plain\\\" },\\n    });\\n  }\\n\\n  console.log(\\\"Received token:\\\", token, \\\"Expected token:\\\", expectedToken);\\n\\n  return new NextResponse(\\\"Forbidden\\\", { status: 403 });''','''  // Meta's challenge is numeric; never reflect arbitrary input.\\n  if (\\n    mode === \\\"subscribe\\\" &&\\n    expectedToken &&\\n    token &&\\n    safeEqual(token, expectedToken) &&\\n    challenge &&\\n    /^\\\\\\\\d{1,64}$/.test(challenge)\\n  ) {\\n    return new Response(challenge, {\\n      status: 200,\\n      headers: { \\\"Content-Type\\\": \\\"text/plain\\\" },\\n    });\\n  }\\n\\n  // Never log the expected token: it's a secret.\\n  console.warn(\\\"[WhatsApp Webhook] Verification failed:\\\", {\\n    mode,\\n    tokenProvided: !!token,\\n    verifyTokenConfigured: !!expectedToken,\\n  });\\n\\n  return new NextResponse(\\\"Forbidden\\\", { status: 403 });''')\\nrep('''export async function POST(request: NextRequest) {\\n  try {\\n    const body = await request.json();\\n''','''function safeEqual(a: string, b: string) {\\n  const left = Buffer.from(a);\\n  const right = Buffer.from(b);\\n  return left.length === right.length && timingSafeEqual(left, right);\\n}\\n\\nconst MAX_WEBHOOK_BYTES = 1024 * 1024;\\n\\nexport async function POST(request: NextRequest) {\\n  try {\\n    const rawBody = await request.text();\\n\\n    if (rawBody.length > MAX_WEBHOOK_BYTES) {\\n      return NextResponse.json({ received: false }, { status: 413 });\\n    }\\n\\n    if (!verifyMetaSignature(rawBody, request.headers.get(\\\"x-hub-signature-256\\\"))) {\\n      console.warn(\\\"[WhatsApp Webhook] Rejected request with an invalid signature.\\\");\\n      return NextResponse.json({ received: false }, { status: 401 });\\n    }\\n\\n    let body;\\n    try {\\n      body = JSON.parse(rawBody);\\n    } catch {\\n      return NextResponse.json({ received: false }, { status: 400 });\\n    }\\n''')\\n# AI config in connection path\\nrep('''  const business = await prisma.business.findUnique({\\n    where: { id: connection.businessId },\\n    select: { businessName: true },\\n  });\\n''','''  const staffConfig = await loadAiStaffConfig(connection.businessId);\\n''')\\nrep('''  const ai = await generateWhatsAppSupportReplyDetailed({\\n    businessName: business?.businessName,\\n    customerMessage: message.text,\\n    history,\\n  });''','''  const ai = await generateWhatsAppSupportReplyDetailed({\\n    businessName: staffConfig?.businessName,\\n    persona: staffConfig?.persona,\\n    knowledge: staffConfig?.knowledge,\\n    customerMessage: message.text,\\n    history,\\n  });''')\\nopen(p,'w').write(s)\\nEOF\"]" cwd=/home/sleeky3750/pulse-web role=server
