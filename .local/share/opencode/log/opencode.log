timestamp=2026-10-07T03:18:01.040Z level=INFO run=9ad1a2a0 message="spawning process" command=/bin/bash args="[\"-c\",\"python3 - <<'EOF'\\np='scripts/link-whatsapp-number.mjs'\\ns=open(p).read()\\ns=s.replace('''import { PrismaClient } from \\\"@prisma/client\\\";\\n''','''import { createCipheriv, createHash, randomBytes } from \\\"node:crypto\\\";\\nimport { PrismaClient } from \\\"@prisma/client\\\";\\n\\n// Must match lib/whatsapp/crypto.ts (enc:v1, AES-256-GCM, sha256-derived key).\\nfunction encryptToken(plain) {\\n  const secret = process.env.WHATSAPP_TOKEN_ENCRYPTION_KEY;\\n  if (!secret || secret.length < 32) {\\n    console.error(\\\"WHATSAPP_TOKEN_ENCRYPTION_KEY (32+ chars) must be set to store tokens.\\\");\\n    process.exit(1);\\n  }\\n  const key = createHash(\\\"sha256\\\").update(secret).digest();\\n  const iv = randomBytes(12);\\n  const cipher = createCipheriv(\\\"aes-256-gcm\\\", key, iv);\\n  const ciphertext = Buffer.concat([cipher.update(plain, \\\"utf8\\\"), cipher.final()]);\\n  const tag = cipher.getAuthTag();\\n  return `enc:v1:${iv.toString(\\\"base64url\\\")}:${tag.toString(\\\"base64url\\\")}:${ciphertext.toString(\\\"base64url\\\")}`;\\n}\\n''')\\ns=s.replace('''// META_WABA_ID, or \\\"unknown\\\". The access token is read from META_ACCESS_TOKEN.''','''// META_WABA_ID, or \\\"unknown\\\". The access token is read from META_ACCESS_TOKEN\\n// and stored encrypted (requires WHATSAPP_TOKEN_ENCRYPTION_KEY).\\n//\\n// Tip: admins can do the same from /dashboard/settings/team → System & Integration.''')\\ns=s.replace('''  const connection = await prisma.whatsAppConnection.upsert({''','''  const tokenFields = {\\n    accessTokenEncrypted: encryptToken(accessToken),\\n    tokenLast4: accessToken.slice(-4),\\n    tokenUpdatedAt: new Date(),\\n  };\\n\\n  const connection = await prisma.whatsAppConnection.upsert({''')\\ns=s.replace('''      accessTokenEncrypted: accessToken,\\n      status: \\\"CONNECTED\\\",\\n    },\\n    update: { accessTokenEncrypted: accessToken, status: \\\"CONNECTED\\\" },''','''      ...tokenFields,\\n      status: \\\"CONNECTED\\\",\\n    },\\n    update: { ...tokenFields, status: \\\"CONNECTED\\\" },''')\\ns=s.replace('const business = await prisma.business.findUnique({ where: { email } });','const business = await prisma.business.findFirst({\\\\n    where: { email: { equals: email, mode: \\\"insensitive\\\" } },\\\\n  });')\\nopen(p,'w').write(s)\\nEOF\\ngrep -n \\\"accessTokenEncrypted\\\\|tokenFields\\\\|insensitive\\\" scripts/link-whatsapp-number.mjs\"]" cwd=/home/sleeky3750/pulse-web role=server
