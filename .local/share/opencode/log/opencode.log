timestamp=2026-10-07T07:27:57.592Z level=INFO run=bd475466 message="spawning process" command=/bin/bash args="[\"-c\",\"python3 - <<'EOF'\\np='app/api/webhooks/whatsapp/route.ts'\\ns=open(p).read()\\nstart=s.index('''/**\\n * Records an inbound media/location/etc. message as a system notice''')\\nend=s.index('''  await saveInboundWhatsAppMessage({\\n    phoneNumberId,\\n    senderPhoneNumber: media.from,\\n    messageBody: notice,\\n    wamid: media.id,\\n    timestamp: media.timestamp,\\n  });\\n}\\n''')+len('''  await saveInboundWhatsAppMessage({\\n    phoneNumberId,\\n    senderPhoneNumber: media.from,\\n    messageBody: notice,\\n    wamid: media.id,\\n    timestamp: media.timestamp,\\n  });\\n}\\n''')\\nnew='''/**\\n * Records an inbound media/location/etc. message as a system notice in the\\n * thread (INBOUND + SYSTEM: counts toward unread, excluded from AI history),\\n * then, for eligible types, sends the automated MEDIA_FALLBACK_REPLY through\\n * the normal outbound pipeline. The reply is skipped in HUMAN mode and\\n * throttled to one per thread per MEDIA_REPLY_COOLDOWN_MS (photo albums arrive\\n * as several messages). Never throws.\\n */\\nasync function handleMediaNotice(\\n  phoneNumberId: string,\\n  connection: WhatsAppConnection | null,\\n  media: IncomingMediaMessage,\\n  profileName: string | null\\n) {\\n  const notice = mediaNoticeText(media.label);\\n  const autoReply = shouldAutoReplyToMedia(media.label);\\n\\n  logLater({\\n    type: \\\"WEBHOOK_RECEIVED\\\",\\n    businessId: connection?.businessId,\\n    phoneNumberId,\\n    message: `Unsupported ${media.label} message received from ${maskPhone(media.from)}`,\\n  });\\n\\n  if (connection) {\\n    let conversation: { id: string; mode: \\\"AI\\\" | \\\"HUMAN\\\" } | null = null;\\n\\n    try {\\n      const ensured = await ensureConversation(connection, media.from, profileName);\\n\\n      if (media.id) {\\n        const existing = await prisma.message.findUnique({\\n          where: { externalId: media.id },\\n          select: { id: true },\\n        });\\n        if (existing) return; // Meta redelivery: already noted (and replied to)\\n      }\\n\\n      await prisma.message.create({\\n        data: {\\n          conversationId: ensured.conversation.id,\\n          businessId: connection.businessId,\\n          externalId: media.id,\\n          direction: \\\"INBOUND\\\",\\n          sender: \\\"SYSTEM\\\",\\n          type: mediaMessageType(media.label),\\n          text: notice,\\n          status: \\\"RECEIVED\\\",\\n          createdAt: media.timestamp,\\n        },\\n      });\\n\\n      await prisma.conversation.update({\\n        where: { id: ensured.conversation.id },\\n        data: { lastMessageAt: new Date() },\\n      });\\n\\n      conversation = { id: ensured.conversation.id, mode: ensured.conversation.mode };\\n    } catch (error) {\\n      console.error(\\n        \\\"[WhatsApp Webhook] Failed to record media notice, using fallback log:\\\",\\n        error instanceof Error ? error.message : error\\n      );\\n    }\\n\\n    if (conversation) {\\n      if (autoReply) {\\n        await sendMediaReplyViaConnection(connection, conversation, media.from);\\n      }\\n      return;\\n    }\\n  }\\n\\n  // No connection (or a DB failure above): record in the fallback log and\\n  // reply with process.env credentials, mirroring the text-message fallback.\\n  const inbound = await saveInboundWhatsAppMessage({\\n    phoneNumberId,\\n    senderPhoneNumber: media.from,\\n    messageBody: notice,\\n    wamid: media.id,\\n    timestamp: media.timestamp,\\n  });\\n\\n  if (inbound === \\\"duplicate\\\") return;\\n\\n  if (autoReply) {\\n    await sendMediaReplyViaEnv(phoneNumberId, media.from, connection?.businessId ?? null);\\n  }\\n}\\n\\nfunction logMediaReplyOutcome(\\n  success: boolean,\\n  businessId: string | null,\\n  phoneNumberId: string,\\n  to: string\\n) {\\n  logLater(\\n    success\\n      ? {\\n          type: \\\"AI_REPLY\\\",\\n          businessId,\\n          phoneNumberId,\\n          message: `Sent media fallback reply to ${maskPhone(to)}`,\\n        }\\n      : {\\n          type: \\\"SEND_FAILED\\\",\\n          businessId,\\n          phoneNumberId,\\n          message: `Meta rejected the media fallback reply to ${maskPhone(to)}.`,\\n        }\\n  );\\n}\\n\\n/** DB-backed path: respects HUMAN mode and the per-thread cooldown. */\\nasync function sendMediaReplyViaConnection(\\n  connection: WhatsAppConnection,\\n  conversation: { id: string; mode: \\\"AI\\\" | \\\"HUMAN\\\" },\\n  to: string\\n) {\\n  try {\\n    if (conversation.mode === \\\"HUMAN\\\") {\\n      console.log(\\\"[WhatsApp Webhook] Human takeover active, skipping media fallback reply:\\\", {\\n        conversationId: conversation.id,\\n      });\\n      return;\\n    }\\n\\n    try {\\n      const recent = await prisma.message.findFirst({\\n        where: {\\n          conversationId: conversation.id,\\n          direction: \\\"OUTBOUND\\\",\\n          sender: \\\"PULSE\\\",\\n          text: MEDIA_FALLBACK_REPLY,\\n          status: \\\"SENT\\\",\\n          createdAt: { gte: new Date(Date.now() - MEDIA_REPLY_COOLDOWN_MS) },\\n        },\\n        select: { id: true },\\n      });\\n\\n      if (recent) {\\n        console.log(\\\"[WhatsApp Webhook] Media fallback reply already sent recently, skipping.\\\");\\n        return;\\n      }\\n    } catch (error) {\\n      // If the cooldown check fails, prefer replying over silence.\\n      console.warn(\\n        \\\"[WhatsApp Webhook] Media reply cooldown check failed:\\\",\\n        error instanceof Error ? error.message : error\\n      );\\n    }\\n\\n    const accessToken = resolveAccessToken(connection.accessTokenEncrypted);\\n\\n    if (!accessToken) {\\n      console.warn(\\\"WhatsApp credentials missing, media reply not dispatched:\\\", connection.id);\\n      return;\\n    }\\n\\n    const sendResult = await safeSend({\\n      phoneNumberId: connection.phoneNumberId,\\n      accessToken,\\n      to,\\n      text: MEDIA_FALLBACK_REPLY,\\n    });\\n\\n    logMediaReplyOutcome(sendResult.success, connection.businessId, connection.phoneNumberId, to);\\n\\n    try {\\n      await prisma.message.create({\\n        data: {\\n          conversationId: conversation.id,\\n          businessId: connection.businessId,\\n          externalId: sendResult.externalId ?? null,\\n          direction: \\\"OUTBOUND\\\",\\n          sender: \\\"PULSE\\\",\\n          type: \\\"TEXT\\\",\\n          text: MEDIA_FALLBACK_REPLY,\\n          status: sendResult.success ? \\\"SENT\\\" : \\\"FAILED\\\",\\n          // Canned reply: no latency, so it doesn't skew \\\"avg AI response time\\\".\\n          latencyMs: null,\\n        },\\n      });\\n\\n      if (sendResult.success) {\\n        await prisma.conversation.update({\\n          where: { id: conversation.id },\\n          data: { lastMessageAt: new Date() },\\n        });\\n      }\\n    } catch (error) {\\n      console.error(\\n        \\\"[WhatsApp DB] Failed to save media fallback reply:\\\",\\n        error instanceof Error ? error.message : error\\n      );\\n    }\\n  } catch (error) {\\n    console.error(\\\"[WhatsApp Webhook] Media fallback reply failed:\\\", error);\\n  }\\n}\\n\\n/** process.env path (no connection row, or the DB failed). */\\nasync function sendMediaReplyViaEnv(\\n  phoneNumberId: string,\\n  to: string,\\n  businessId: string | null\\n) {\\n  try {\\n    const fallbackPhoneNumberId =\\n      process.env.META_PHONE_NUMBER_ID ?? process.env.WHATSAPP_PHONE_NUMBER_ID;\\n    const fallbackAccessToken = envAccessToken();\\n\\n    if (!fallbackPhoneNumberId || !fallbackAccessToken) {\\n      console.error(\\\"[WhatsApp Webhook] Media fallback reply skipped: process.env credentials missing.\\\");\\n      return;\\n    }\\n\\n    try {\\n      const recent = await withTimeout(\\n        prisma.whatsAppMessage.findFirst({\\n          where: {\\n            phoneNumberId,\\n            senderPhoneNumber: to,\\n            direction: \\\"OUTBOUND\\\",\\n            messageBody: MEDIA_FALLBACK_REPLY,\\n            status: \\\"SENT\\\",\\n            timestamp: { gte: new Date(Date.now() - MEDIA_REPLY_COOLDOWN_MS) },\\n          },\\n          select: { id: true },\\n        }),\\n        3000,\\n        \\\"Media reply cooldown check\\\"\\n      );\\n\\n      if (recent) return;\\n    } catch (error) {\\n      console.warn(\\n        \\\"[WhatsApp Webhook] Media reply cooldown check failed:\\\",\\n        error instanceof Error ? error.message : error\\n      );\\n    }\\n\\n    const sendResult = await safeSend({\\n      phoneNumberId: fallbackPhoneNumberId,\\n      accessToken: fallbackAccessToken,\\n      to,\\n      text: MEDIA_FALLBACK_REPLY,\\n    });\\n\\n    logMediaReplyOutcome(sendResult.success, businessId, phoneNumberId, to);\\n\\n    await saveOutboundWhatsAppMessage({\\n      phoneNumberId,\\n      senderPhoneNumber: to,\\n      messageBody: MEDIA_FALLBACK_REPLY,\\n      wamid: sendResult.externalId,\\n      status: sendResult.success ? \\\"SENT\\\" : \\\"FAILED\\\",\\n    });\\n  } catch (error) {\\n    console.error(\\\"[WhatsApp Webhook] Media fallback reply failed:\\\", error);\\n  }\\n}\\n'''\\ns=s[:start]+new+s[end:]\\ns=s.replace('''import { mediaLabel, mediaMessageType, mediaNoticeText } from \\\"@/lib/whatsapp/media\\\";''','''import {\\n  MEDIA_FALLBACK_REPLY,\\n  MEDIA_REPLY_COOLDOWN_MS,\\n  mediaLabel,\\n  mediaMessageType,\\n  mediaNoticeText,\\n  shouldAutoReplyToMedia,\\n} from \\\"@/lib/whatsapp/media\\\";''')\\nopen(p,'w').write(s)\\nEOF\\ngrep -c \\\"sendMediaReplyVia\\\" app/api/webhooks/whatsapp/route.ts\"]" cwd=/home/sleeky3750/pulse-web http.span=6302643 role=server
