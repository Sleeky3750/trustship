timestamp=2026-10-07T05:34:56.029Z level=INFO run=9ad1a2a0 message="spawning process" command=/bin/bash args="[\"-c\",\"python3 - <<'EOF'\\np='components/console/settings/AiTab.tsx'\\ns=open(p).read()\\ns=s.replace('import { useState } from \\\"react\\\";','import { useRef, useState } from \\\"react\\\";',1)\\nold='''  const [saving, setSaving] = useState(false);\\n\\n  usePolling(\\n    async (signal) => {\\n      try {\\n        const data = await readJson(await fetch(\\\"/api/settings/ai\\\", { cache: \\\"no-store\\\", signal }));\\n        setSaved((current) => {\\n          if (current === null) setDraft(data.persona);\\n          return current ?? data.persona;\\n        });'''\\nnew='''  const [saving, setSaving] = useState(false);\\n  const loadedRef = useRef(false);\\n\\n  usePolling(\\n    async (signal) => {\\n      try {\\n        const data = await readJson(await fetch(\\\"/api/settings/ai\\\", { cache: \\\"no-store\\\", signal }));\\n        // Load once; later polls must not overwrite an in-progress edit.\\n        if (!loadedRef.current) {\\n          loadedRef.current = true;\\n          setSaved(data.persona);\\n          setDraft(data.persona);\\n        }'''\\nassert s.count(old)==1\\ns=s.replace(old,new)\\nopen(p,'w').write(s)\\nEOF\"]" cwd=/home/sleeky3750/pulse-web role=server
