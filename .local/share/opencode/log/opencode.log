timestamp=2026-10-07T05:29:59.260Z level=INFO run=9ad1a2a0 message="spawning process" command=/bin/bash args="[\"-c\",\"python3 - <<'EOF'\\ndef edit(p, pairs):\\n    s=open(p).read()\\n    for old,new in pairs:\\n        assert s.count(old)==1, (p, old[:70])\\n        s=s.replace(old,new)\\n    open(p,'w').write(s)\\nedit('lib/whatsapp/types.ts',[('''    /** Start of the counting window (UTC midnight). */\\n    since: string;''','''    /** Start of the counting window (midnight in the business timezone). */\\n    since: string;\\n    timezone: string;''')])\\nedit('lib/whatsapp/inbox.ts',[\\n('''  const now = Date.now();\\n  const startOfToday = new Date(now);\\n  startOfToday.setUTCHours(0, 0, 0, 0);''','''  const now = Date.now();\\n  const business = await prisma.business.findUnique({\\n    where: { id: businessId },\\n    select: { timezone: true },\\n  });\\n  const timezone = business?.timezone ?? \\\"UTC\\\";\\n  const startOfToday = startOfTodayIn(timezone);'''),\\n('''      since: startOfToday.toISOString(),\\n    },''','''      since: startOfToday.toISOString(),\\n      timezone,\\n    },'''),\\n('''function deriveSystemState(input: {''','''/** Midnight \\\"today\\\" in an IANA timezone, as a UTC instant. */\\nexport function startOfTodayIn(timeZone: string): Date {\\n  const now = new Date();\\n\\n  try {\\n    const parts = Object.fromEntries(\\n      new Intl.DateTimeFormat(\\\"en-US\\\", {\\n        timeZone,\\n        year: \\\"numeric\\\",\\n        month: \\\"2-digit\\\",\\n        day: \\\"2-digit\\\",\\n        hour: \\\"2-digit\\\",\\n        minute: \\\"2-digit\\\",\\n        second: \\\"2-digit\\\",\\n        hourCycle: \\\"h23\\\",\\n      })\\n        .formatToParts(now)\\n        .map((part) => [part.type, part.value])\\n    );\\n\\n    const localAsUtc = Date.UTC(\\n      Number(parts.year),\\n      Number(parts.month) - 1,\\n      Number(parts.day),\\n      Number(parts.hour),\\n      Number(parts.minute),\\n      Number(parts.second)\\n    );\\n    const offsetMs = localAsUtc - Math.floor(now.getTime() / 1000) * 1000;\\n    const localMidnightAsUtc = Date.UTC(\\n      Number(parts.year),\\n      Number(parts.month) - 1,\\n      Number(parts.day)\\n    );\\n\\n    return new Date(localMidnightAsUtc - offsetMs);\\n  } catch {\\n    const fallback = new Date(now);\\n    fallback.setUTCHours(0, 0, 0, 0);\\n    return fallback;\\n  }\\n}\\n\\nfunction deriveSystemState(input: {'''),\\n])\\nEOF\\nnode -e '\\nfunction s(tz){const now=new Date();const p=Object.fromEntries(new Intl.DateTimeFormat(\\\"en-US\\\",{timeZone:tz,year:\\\"numeric\\\",month:\\\"2-digit\\\",day:\\\"2-digit\\\",hour:\\\"2-digit\\\",minute:\\\"2-digit\\\",second:\\\"2-digit\\\",hourCycle:\\\"h23\\\"}).formatToParts(now).map(x=>[x.type,x.value]));const l=Date.UTC(+p.year,+p.month-1,+p.day,+p.hour,+p.minute,+p.second);const o=l-Math.floor(now/1000)*1000;return new Date(Date.UTC(+p.year,+p.month-1,+p.day)-o)}\\nfor (const tz of [\\\"UTC\\\",\\\"Africa/Lagos\\\",\\\"America/New_York\\\",\\\"Asia/Kolkata\\\"]) console.log(tz, s(tz).toISOString(), s(tz).toLocaleString(\\\"en-US\\\",{timeZone:tz}))'\"]" cwd=/home/sleeky3750/pulse-web role=server
