timestamp=2026-10-07T02:46:34.497Z level=INFO run=e41d4e8e message="spawning process" command=/bin/bash args="[\"-c\",\"python3 - <<'EOF'\\np='app/api/webhooks/whatsapp/route.ts'\\ns=open(p).read()\\ndef rep(old,new):\\n    global s\\n    assert s.count(old)==1, old[:80]\\n    s=s.replace(old,new)\\n\\nrep('''import { NextRequest, NextResponse } from \\\"next/server\\\";''','''import { NextRequest, NextResponse, after } from \\\"next/server\\\";''')\\nrep('''  generateWhatsAppSupportReply,\\n  type WhatsAppHistoryMessage,''','''  generateWhatsAppSupportReplyDetailed,\\n  type WhatsAppHistoryMessage,''')\\nrep('''import { sendWhatsAppTextMessage } from \\\"@/lib/whatsapp/send\\\";''','''import { sendWhatsAppTextMessage } from \\\"@/lib/whatsapp/send\\\";\\nimport { envAccessToken, resolveAccessToken } from \\\"@/lib/whatsapp/crypto\\\";\\nimport { logWhatsAppEvent, maskPhone } from \\\"@/lib/whatsapp/events\\\";''')\\nrep('''  text: string;\\n  timestamp: Date;\\n}''','''  text: string;\\n  timestamp: Date;\\n  /** When this webhook began processing the message, for reply latency. */\\n  receivedAtMs: number;\\n}\\n\\n/** Logs an event after the response is sent, so it adds no reply latency. */\\nfunction logLater(event: Parameters<typeof logWhatsAppEvent>[0]) {\\n  after(() => logWhatsAppEvent(event));\\n}''')\\n\\nrep('''        const connection = await findConnection(phoneNumberId);\\n''','''        const { connection, lookupFailed } =\\n          await findConnection(phoneNumberId);\\n\\n        if (lookupFailed) {\\n          logLater({\\n            type: \\\"DB_FALLBACK\\\",\\n            phoneNumberId,\\n            message:\\n              \\\"Connection lookup failed or timed out; replying with process.env credentials.\\\",\\n          });\\n        }\\n''')\\nrep('''            continue;\\n          }\\n\\n          if (!connection) {''','''            continue;\\n          }\\n\\n          logLater({\\n            type: \\\"WEBHOOK_RECEIVED\\\",\\n            businessId: connection?.businessId,\\n            phoneNumberId,\\n            message: `Message received from ${maskPhone(message.from)}`,\\n          });\\n\\n          if (!connection) {''')\\nrep('''            await handleFallbackMessage(phoneNumberId, message);\\n            continue;\\n          }''','''            await handleFallbackMessage(phoneNumberId, message, null);\\n            continue;\\n          }''')\\nrep('''              error instanceof Error ? error.message : error\\n            );\\n            await handleFallbackMessage(phoneNumberId, message);''','''              error instanceof Error ? error.message : error\\n            );\\n            logLater({\\n              type: \\\"DB_FALLBACK\\\",\\n              businessId: connection.businessId,\\n              phoneNumberId,\\n              message: `Database processing failed; replied to ${maskPhone(\\n                message.from\\n              )} with process.env credentials.`,\\n            });\\n            await handleFallbackMessage(\\n              phoneNumberId,\\n              message,\\n              connection.businessId\\n            );''')\\n\\nrep('''async function findConnection(\\n  phoneNumberId: string\\n): Promise<WhatsAppConnection | null> {\\n  try {\\n    // Race the DB lookup against a short timeout so a cold-start\\n    // database does not add seconds of latency to the webhook.\\n    const DB_LOOKUP_TIMEOUT_MS = 1500;\\n\\n    const timeout = new Promise<null>((resolve) =>\\n      setTimeout(() => resolve(null), DB_LOOKUP_TIMEOUT_MS)\\n    );\\n\\n    return await Promise.race([\\n      prisma.whatsAppConnection.findUnique({\\n        where: { phoneNumberId },\\n      }),\\n      timeout,\\n    ]);\\n  } catch (error) {\\n    console.warn(\\n      \\\"[WhatsApp Webhook] DB lookup failed, falling back to process.env credentials:\\\",\\n      error instanceof Error ? error.message : error\\n    );\\n    return null;\\n  }\\n}''','''/**\\n * `lookupFailed` distinguishes \\\"the DB was slow or down\\\" (degraded, so a\\n * DB_FALLBACK event is logged) from \\\"no connection row exists\\\" (normal\\n * process.env mode).\\n */\\nasync function findConnection(phoneNumberId: string): Promise<{\\n  connection: WhatsAppConnection | null;\\n  lookupFailed: boolean;\\n}> {\\n  try {\\n    // Race the DB lookup against a short timeout so a cold-start\\n    // database does not add seconds of latency to the webhook.\\n    const connection = await withTimeout(\\n      prisma.whatsAppConnection.findUnique({\\n        where: { phoneNumberId },\\n      }),\\n      1500,\\n      \\\"Connection lookup\\\"\\n    );\\n\\n    return { connection, lookupFailed: false };\\n  } catch (error) {\\n    console.warn(\\n      \\\"[WhatsApp Webhook] DB lookup failed, falling back to process.env credentials:\\\",\\n      error instanceof Error ? error.message : error\\n    );\\n    return { connection: null, lookupFailed: true };\\n  }\\n}''')\\n\\nrep('''    timestamp: parseMetaTimestamp(message.timestamp),\\n  };\\n}''','''    timestamp: parseMetaTimestamp(message.timestamp),\\n    receivedAtMs: Date.now(),\\n  };\\n}''')\\n\\n# fallback handler\\nrep('''async function handleFallbackMessage(\\n  phoneNumberId: string,\\n  message: IncomingTextMessage\\n) {''','''async function handleFallbackMessage(\\n  phoneNumberId: string,\\n  message: IncomingTextMessage,\\n  /** Known owner, when falling back from the connection path. */\\n  businessId: string | null\\n) {''')\\nrep('''  const generatedAiResponse = await generateWhatsAppSupportReply({\\n    customerMessage: message.text,\\n    history,\\n  });\\n\\n  console.log(\\\"[AI Output]:\\\", generatedAiResponse);\\n\\n  if (!generatedAiResponse?.trim()) {\\n    console.error(\\\"[AI Generation Error]: Empty or invalid AI response\\\");\\n    return;\\n  }\\n\\n  const fallbackPhoneNumberId =\\n    process.env.META_PHONE_NUMBER_ID ?? process.env.WHATSAPP_PHONE_NUMBER_ID;\\n  const fallbackAccessToken =\\n    process.env.META_ACCESS_TOKEN ?? process.env.WHATSAPP_ACCESS_TOKEN;\\n''','''  const ai = await generateWhatsAppSupportReplyDetailed({\\n    customerMessage: message.text,\\n    history,\\n  });\\n  const generatedAiResponse = ai.text;\\n\\n  console.log(\\\"[AI Output]:\\\", generatedAiResponse);\\n\\n  if (ai.usedFallback) {\\n    logLater({\\n      type: \\\"AI_ERROR\\\",\\n      businessId,\\n      phoneNumberId,\\n      message: `AI generation failed (${ai.error}); sent canned reply.`,\\n    });\\n  }\\n\\n  if (!generatedAiResponse?.trim()) {\\n    console.error(\\\"[AI Generation Error]: Empty or invalid AI response\\\");\\n    return;\\n  }\\n\\n  const fallbackPhoneNumberId =\\n    process.env.META_PHONE_NUMBER_ID ?? process.env.WHATSAPP_PHONE_NUMBER_ID;\\n  const fallbackAccessToken = envAccessToken();\\n''')\\nrep('''    to: senderPhoneNumber,\\n    text: generatedAiResponse,\\n  });\\n\\n  await saveOutboundWhatsAppMessage({''','''    to: senderPhoneNumber,\\n    text: generatedAiResponse,\\n  });\\n\\n  logSendOutcome({\\n    success: sendResult.success,\\n    businessId,\\n    phoneNumberId,\\n    to: senderPhoneNumber,\\n    latencyMs: Date.now() - message.receivedAtMs,\\n    aiDurationMs: ai.durationMs,\\n  });\\n\\n  await saveOutboundWhatsAppMessage({''')\\n\\n# connection handler\\nrep('''  const reply = await generateWhatsAppSupportReply({\\n    businessName: business?.businessName,\\n    customerMessage: message.text,\\n    history,\\n  });\\n\\n  console.log(\\\"[AI Output]:\\\", reply);\\n''','''  const ai = await generateWhatsAppSupportReplyDetailed({\\n    businessName: business?.businessName,\\n    customerMessage: message.text,\\n    history,\\n  });\\n  const reply = ai.text;\\n\\n  console.log(\\\"[AI Output]:\\\", reply);\\n\\n  if (ai.usedFallback) {\\n    logLater({\\n      type: \\\"AI_ERROR\\\",\\n      businessId: connection.businessId,\\n      phoneNumberId: connection.phoneNumberId,\\n      message: `AI generation failed (${ai.error}); sent canned reply.`,\\n    });\\n  }\\n''')\\nrep('''  const phoneNumberId =\\n    connection.phoneNumberId ??\\n    process.env.META_PHONE_NUMBER_ID ??\\n    process.env.WHATSAPP_PHONE_NUMBER_ID;\\n  const accessToken =\\n    connection.accessTokenEncrypted ??\\n    process.env.META_ACCESS_TOKEN ??\\n    process.env.WHATSAPP_ACCESS_TOKEN;\\n\\n  if (!phoneNumberId || !accessToken) {''','''  const phoneNumberId = connection.phoneNumberId;\\n  // The connection's own (decrypted) token, else the process.env token\\n  const accessToken = resolveAccessToken(connection.accessTokenEncrypted);\\n\\n  if (!accessToken) {''')\\nrep('''    to: message.from,\\n    text: reply,\\n  });\\n\\n  // The send has been attempted''','''    to: message.from,\\n    text: reply,\\n  });\\n\\n  const latencyMs = Date.now() - message.receivedAtMs;\\n\\n  logSendOutcome({\\n    success: sendResult.success,\\n    businessId: connection.businessId,\\n    phoneNumberId,\\n    to: message.from,\\n    latencyMs,\\n    aiDurationMs: ai.durationMs,\\n  });\\n\\n  // The send has been attempted''')\\nrep('''        text: reply,\\n        status: sendResult.success ? \\\"SENT\\\" : \\\"FAILED\\\",\\n      },\\n    });''','''        text: reply,\\n        status: sendResult.success ? \\\"SENT\\\" : \\\"FAILED\\\",\\n        latencyMs: sendResult.success ? latencyMs : null,\\n      },\\n    });''')\\n\\ns += '''\\nfunction logSendOutcome({\\n  success,\\n  businessId,\\n  phoneNumberId,\\n  to,\\n  latencyMs,\\n  aiDurationMs,\\n}: {\\n  success: boolean;\\n  businessId: string | null;\\n  phoneNumberId: string;\\n  to: string;\\n  latencyMs: number;\\n  aiDurationMs: number;\\n}) {\\n  logLater(\\n    success\\n      ? {\\n          type: \\\"AI_REPLY\\\",\\n          businessId,\\n          phoneNumberId,\\n          latencyMs,\\n          message: `AI replied to ${maskPhone(to)} in ${(latencyMs / 1000).toFixed(\\n            1\\n          )}s (generation ${(aiDurationMs / 1000).toFixed(1)}s)`,\\n        }\\n      : {\\n          type: \\\"SEND_FAILED\\\",\\n          businessId,\\n          phoneNumberId,\\n          message: `Meta rejected the AI reply to ${maskPhone(to)}.`,\\n        }\\n  );\\n}\\n'''\\nopen(p,'w').write(s)\\nEOF\\nnpx tsc --noEmit 2>&1 | head -30\"]" cwd=/home/sleeky3750/pulse-web http.span=3061784 role=server
