\", \\\"Please select a valid CSV file\\\");\\n    }\\n  };\\n\\n  const parseCSV = async (file: File) => {\\n    const reader = new FileReader();\\n    reader.onload = (e) => {\\n      const text = e.target?.result as string;\\n      const result = PapaParse.parse(text, {\\n        header: true,\\n        dynamicTyping: false,\\n        skipEmptyLines: true,\\n      });\\n\\n      const mappedColumns = mapColumns(result.data[0]);\\n      if (mappedColumns) {\\n        setColumns(mappedColumns);\\n        // Parse all rows and validate\\n        const parsedRows: ParsedRow[] = result.data.slice(1).map((row: any) => {\\n          const validated = validateRow(row, mappedColumns);\\n          return {\\n            ...parsedRowToProduct(row, mappedColumns),\\n            validation: validated.validationStatus ? \\\"valid\\\" : \\\"invalid\\\",\\n            errors: validated.errors,\\n          };\\n        });\\n        setPreview(parsedRows);\\n        setStep(3);\\n      }\\n    };\\n    reader.readAsText(file);\\n  };\\n\\n  const mapColumns = (firstRow: any): CSVColumnMapping | null => {\\n    const name = findColumn(firstRow, [\\\"name\\\", \\\"product\\\", \\\"item\\\", \\\"title\\\"]);\\n    const price = findColumn(firstRow, [\\\"price\\\", \\\"cost\\\", \\\"amount\\\"]);\\n    const category = findColumn(firstRow, [\\\"category\\\", \\\"type\\\", \\\"class\\\"]);\\n    const description = findColumn(firstRow, [\\\"description\\\", \\\"details\\\", \\\"notes\\\"]);\\n    const stock = findColumn(firstRow, [\\\"stock\\\", \\\"quantity\\\", \\\"inventory\\\"]);\\n\\n    if (!name || !price) return null;\\n\\n    return {\\n      name,\\n      price,\\n      category: category || \\\"General\\\",\\n      description,\\n      stock,\\n    };\\n  };\\n\\n  const findColumn = (row: any, possibleNames: string[]): string | null => {\\n    for (const name of possibleNames) {\\n      if (row[name] !== undefined && row[name] !== null && row[name] !== \\\"\\\") {\\n        return name;\\n      }\\n    }\\n    return null;\\n  };\\n\\n  const validateRow = (row: any, mapping: CSVColumnMapping): { validationStatus: boolean; errors: string[] } => {\\n    const errors: string[] = [];\\n\\n    if (!row[mapping.name]) errors.push(\\\"Missing product name\\\");\\n    if (!row[mapping.price]) errors.push(\\\"Missing price\\\");\\n    else if (isNaN(Number(row[mapping.price]))) errors.push(\\\"Price must be a valid number\\\");\\n\\n    return {\\n      validationStatus: errors.length === 0,\\n      errors,\\n    };\\n  };\\n\\n  const parsedRowToProduct = (row: any, mapping: CSVColumnMapping): ParsedRow => {\\n    const price = Number(row[mapping.price]);\\n    const stock = mapping.stock ? Number(row[mapping.stock]) || 0 : 0;\\n\\n    return {\\n      name: row[mapping.name],\\n      price,\\n      category: mapping.category || \\\"General\\\",\\n      description: mapping.description ? row[mapping.description] : undefined,\\n      stock,\\n    };\\n  };\\n\\n  // Step 2: Column Mapping & Preview\\n  const handleImport = async () => {\\n    if (!columns || !preview.length) return;\\n\\n    setImporting(true);\\n    setProgress(0);\\n\\n    // Simulate batch import - in real app, this would be API calls\\n    const totalRows = preview.length;\\n    let imported = 0;\\n\\n    preview.forEach((row, index) => {\\n      // Simulate async import\\n      setTimeout(() => {\\n        importProduct(row);\\n        imported++;\\n        setProgress((imported / totalRows) * 100);\\n\\n        if (imported === totalRows) {\\n          setImporting(false);\\n          setStep(4);\\n          showToast(\\n            \\\"success\\\",\\n            ` ${imported} Products Successfully Uploaded & Learned by AI Staff!`\\n          );\\n        }\\n      }, index * 300);\\n    });\\n  };\\n\\n  const importProduct = (product: ParsedRow) => {\\n    // In real app, this would call /api/catalog to save each product\\n    // For now, just add to local state\\n  };\\n\\n  // Step 1: File Upload\\n  const renderStepOne = () => (\\n    <div className=\\\"p-6\\\">\\n      <h2 className=\\\"text-xl font-semibold text-zinc-100 mb-4\\\">\\n        Upload CSV File\\n      </h2>\\n\\n      <div className=\\\"border-2 border-zinc-700 bg-zinc-950/50 rounded-xl p-8 text-center min-h-[200px]\\\">\\n        <svg\\n          xmlns=\\\"http://www.w3.org/2000/svg\\\"\\n          className=\\\"h-12 w-12 mx-auto mb-4 text-zinc-500\\\"\\n          viewBox=\\\"0 0 24 24\\\"\\n          fill=\\\"none\\\"\\n        >\\n          <path\\n            d=\\\"M21 15v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2zm-2-3v5a2 2 0 0 0 2 2h3a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-3zM4 11a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6zm7 5H5v2h14v-2zm-3-8v2h14V9h-3z\\\"\\n          />\\n        </svg>\\n\\n        <p className=\\\"text-zinc-400 mb-4\\\">Drag & drop a CSV file here</p>\\n\\n        <input\\n          type=\\\"file\\\"\\n          accept=\\\".csv\\\"\\n          onChange={handleFileChange}\\n          className=\\\"hidden\\\"\\n          ref={setFileInput}\\n        />\\n        <button\\n          onClick={() => fileInput?.click()}\\n          className=\\\"rounded-lg border border-zinc-700 bg-zinc-950/50 px-6 py-3 text-sm text-zinc-400 hover:bg-zinc-900 transition-colors cursor-pointer\\\"\\n        >\\n          Browse Files\\n        </button>\\n      </div>\\n\\n      {columns && (\\n        <div className=\\\"mt-6 pt-6 border-t border-zinc-700/50\\\">\\n          <h3 className=\\\"text-sm text-zinc-500 mb-3\\\">Column Mapping</h3>\\n          <p className=\\\"text-zinc-500 text-xs\\\">\\n            Auto-detected columns: {columns.name}, {columns.price}{columns.category && `, ${columns.category}`}\\n          </p>\\n        </div>\\n      )}\\n\\n      <button\\n        onClick={() => setStep(2)}\\n        className=\\\"mt-4 rounded-lg border border-zinc-700 bg-zinc-950/50 px-6 py-3 text-sm text-zinc-400 hover:bg-zinc-900 transition-colors\\\"\\n        disabled={preview.length > 0}\\n      >\\n        <svg\\n          xmlns=\\\"http://www.w3.org/2000/svg\\\"\\n          className=\\\"h-4 w-4 mr-2\\\"\\n          viewBox=\\\"0 0 24 24\\\"\\n          fill=\\\"currentColor\\\"\\n        >\\n          <path d=\\\"M10 6L8.12 7.12 17.88 7.12 15 9z\\\" />\\n          <path d=\\\"M12 3v6l5 5v-6l-2.5 2.5L15 12l3.5 3.5L21 9z\\\" />\\n        </svg>\\n        Download Sample CSV\\n      </button>\\n    </div>\\n  );\\n\\n  // Step 2: Column Mapping & Preview\\n  const renderStepTwo = () => (\\n    <div className=\\\"p-6\\\">\\n      <h2 className=\\\"text-xl font-semibold text-zinc-100 mb-4\\\">\\n        Column Mapping & Preview\\n      </h2>\\n\\n      {/* Mapping Summary */}\\n      <div className=\\\"grid grid-cols-2 gap-3 mb-6\\\">\\n        <div>\\n          <p className=\\\"text-zinc-500 text-sm mb-1\\\">Product Name Column</p>\\n          <p className=\\\"font-medium text-zinc-300\\\">{columns?.name}</p>\\n        </div>\\n        <div>\\n          <p className=\\\"text-zinc-500 text-sm mb-1\\\">Price Column</p>\\n          <p className=\\\"font-medium text-zinc-300\\\">{columns?.price}</p>\\n        </div>\\n      </div>\\n\\n      {/* Preview Grid */}\\n      <div className=\\\"overflow-x-auto rounded-border bg-zinc-900/50\\\">\\n        <table className=\\\"w-full text-sm text-zinc-400\\\">\\n          <thead>\\n            <tr>\\n              <th className=\\\"py-2 px-3\\\">#</th>\\n              <th className=\\\"py-2 px-3\\\">Name</th>\\n              <th className=\\\"py-2 px-3\\\">Price</th>\\n              <th className=\\\"py-2 px-3\\\">Category</th>\\n              <th className=\\\"py-2 px-3\\\">Stock</th>\\n              <th className=\\\"py-2 px-3\\\">Valid</th>\\n            </th>\\n          </thead>\\n          <tbody>\\n            {preview.map((row, index) => (\\n              <tr key={index} className=\\\"border-b border-zinc-800/50\\\">\\n                <td className=\\\"py-2 px-3\\\">{index + 1}</td>\\n                <td className=\\\"py-2 px-3\\\">{row.name}</td>\\n                <td className=\\\"py-2 px-3\\\">${row.price.toFixed(2)}</td>\\n                <td className=\\\"py-2 px-3\\\">{row.category}</td>\\n                <td className=\\\"py-2 px-3\\\">{row.stock || 0}</td>\\n                <td className=\\\"py-2 px-3\\\">\\n                  {row.validation === \\\"valid\\\" ? (\\n                    <span className=\\\"text-emerald-500 text-xs font-medium\\\">✓ Valid</span>\\n                  ) : (\\n                    <span className=\\\"text-red-500 text-xs font-medium\\\">✗ ${row.errors?.[0] || \\\"Invalid\\\"}</span>\\n                  )\\n                  </span>\\n                </td>\\n              </tr>\\n            ))}\\n          </tbody>\\n        </table>\\n      </div>\\n\\n      <p className=\\\"mt-4 text-zinc-500 text-sm\\\">\\n        Review and adjust the column mapping above if needed\\n      </p>\\n    </div>\\n  );\\n\\n  // Step 3: Import Progress\\n  const renderStepThree = () => (\\n    <div className=\\\"p-6\\\">\\n      <h2 className=\\\"text-xl font-semibold text-zinc-100 mb-4\\\">\\n        Import Progress\\n      </h2>\\n\\n      <div className=\\\"h-8 bg-zinc-900/50 rounded-full overflow-hidden\\\">\\n        <div\\n          className=\\\"h-full bg-indigo-600 transition-all duration-500 ease-out width-{progress}%\\\"\\n        />\\n      </div>\\n      <p className=\\\"text-zinc-400 text-sm mt-2\\\">\\n        {progress}% imported\\n      </p>\\n    </div>\\n  );\\n\\n  // Step 4: Success screen\\n  const renderStepFour = () => (\\n    <div className=\\\"p-6\\\">\\n      <h2 className=\\\"text-xl font-semibold text-zinc-100 mb-4\\\">\\n        Import Complete\\n      </h2>\\n\\n      <p className=\\\"text-zinc-400 mb-4\\\">\\n        Your CSV data has been imported and the AI staff has learned from it.\\n      </p>\\n\\n      <button\\n        onClick={() => 