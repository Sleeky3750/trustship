timestamp=2026-10-07T02:42:56.612Z level=INFO run=e41d4e8e message="spawning process" command=/bin/bash args="[\"-c\",\"cp prisma/schema.prisma /tmp/opencode/pre-team-schema.prisma && python3 - <<'EOF'\\np='prisma/schema.prisma'\\ns=open(p).read()\\ndef rep(old,new):\\n    global s\\n    assert s.count(old)==1, old\\n    s=s.replace(old,new)\\n\\n# Business: legacy login comment + relations\\nrep(\\\"\\\"\\\"  password            String\\n  emailVerified       Boolean              @default(false)\\\"\\\"\\\",\\\"\\\"\\\"  // Legacy login hash. Logins now authenticate against User; this column is\\n  // kept (and still written on signup) for backwards compatibility.\\n  password            String\\n  emailVerified       Boolean              @default(false)\\\"\\\"\\\")\\nrep(\\\"\\\"\\\"  conversations       Conversation[]\\n  messages            Message[]\\n}\\\"\\\"\\\",\\\"\\\"\\\"  conversations       Conversation[]\\n  messages            Message[]\\n  teamMembers         TeamMember[]\\n  whatsappEvents      WhatsAppEvent[]\\n}\\n\\n// A person who can log in. Users join businesses through TeamMember rows;\\n// the Business is the tenant/organization boundary.\\nmodel User {\\n  id          String       @id @default(cuid())\\n  email       String       @unique\\n  name        String?\\n  password    String\\n  createdAt   DateTime     @default(now())\\n  updatedAt   DateTime     @updatedAt\\n  memberships TeamMember[]\\n}\\n\\nenum TeamRole {\\n  OWNER\\n  ADMIN\\n  AGENT\\n  VIEWER\\n}\\n\\nenum TeamMemberStatus {\\n  INVITED\\n  ACTIVE\\n}\\n\\nmodel TeamMember {\\n  id              String           @id @default(cuid())\\n  businessId      String\\n  // Null until the invite is accepted\\n  userId          String?\\n  // Invite email (lowercase); matches User.email once accepted\\n  email           String\\n  role            TeamRole\\n  status          TeamMemberStatus @default(INVITED)\\n  // sha256 of the single-use invite token; the raw token is never stored\\n  inviteTokenHash String?          @unique\\n  inviteExpiresAt DateTime?\\n  invitedById     String?\\n  joinedAt        DateTime?\\n  createdAt       DateTime         @default(now())\\n  updatedAt       DateTime         @updatedAt\\n\\n  business              Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)\\n  user                  User?              @relation(fields: [userId], references: [id], onDelete: Cascade)\\n  assignedConversations Conversation[]\\n  conversationReads     ConversationRead[]\\n\\n  @@unique([businessId, email])\\n  @@unique([businessId, userId])\\n  @@index([userId])\\n}\\\"\\\"\\\")\\n\\n# Connection: token metadata\\nrep(\\\"\\\"\\\"  accessTokenEncrypted String\\n  status               WhatsAppConnectionStatus @default(CONNECTING)\\\"\\\"\\\",\\\"\\\"\\\"  // AES-256-GCM ciphertext (\\\"enc:v1:...\\\"). Older rows may hold plaintext;\\n  // lib/whatsapp/crypto.ts reads both.\\n  accessTokenEncrypted String\\n  // Last 4 characters of the token, for display only\\n  tokenLast4           String?\\n  tokenUpdatedAt       DateTime?\\n  status               WhatsAppConnectionStatus @default(CONNECTING)\\\"\\\"\\\")\\n\\n# Conversation: assignment + reads\\nrep(\\\"\\\"\\\"  lastMessageAt        DateTime?\\n  createdAt            DateTime           @default(now())\\n  updatedAt            DateTime           @updatedAt\\n\\n  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)\\n  customer           Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)\\n  whatsappConnection WhatsAppConnection @relation(fields: [whatsappConnectionId], references: [id], onDelete: Cascade)\\n  messages           Message[]\\n\\\"\\\"\\\",\\\"\\\"\\\"  lastMessageAt        DateTime?\\n  assignedMemberId     String?\\n  createdAt            DateTime           @default(now())\\n  updatedAt            DateTime           @updatedAt\\n\\n  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)\\n  customer           Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)\\n  whatsappConnection WhatsAppConnection @relation(fields: [whatsappConnectionId], references: [id], onDelete: Cascade)\\n  assignedMember     TeamMember?        @relation(fields: [assignedMemberId], references: [id], onDelete: SetNull)\\n  messages           Message[]\\n  reads              ConversationRead[]\\n\\\"\\\"\\\")\\nrep(\\\"\\\"\\\"  @@index([lastMessageAt])\\n}\\\"\\\"\\\",\\\"\\\"\\\"  @@index([lastMessageAt])\\n  @@index([assignedMemberId])\\n}\\n\\n// Per-member read marker, used for unread badges in the inbox.\\nmodel ConversationRead {\\n  conversationId String\\n  memberId       String\\n  lastReadAt     DateTime\\n\\n  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)\\n  member       TeamMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)\\n\\n  @@id([conversationId, memberId])\\n  @@index([memberId])\\n}\\\"\\\"\\\")\\n\\n# Message: latency\\nrep(\\\"\\\"\\\"  status         WhatsAppMessageStatus?\\n  createdAt      DateTime               @default(now())\\\"\\\"\\\",\\\"\\\"\\\"  status         WhatsAppMessageStatus?\\n  // AI replies only: ms from webhook receipt to Meta accepting the reply\\n  latencyMs      Int?\\n  createdAt      DateTime               @default(now())\\\"\\\"\\\")\\n\\ns += \\\"\\\"\\\"\\nenum WhatsAppEventType {\\n  WEBHOOK_RECEIVED\\n  AI_REPLY\\n  AI_ERROR\\n  SEND_FAILED\\n  DB_FALLBACK\\n}\\n\\n// Operational event log for the Pulse dashboard. businessId is set when the\\n// owning business is known; otherwise phoneNumberId scopes the event the same\\n// way WhatsAppMessage rows are scoped.\\nmodel WhatsAppEvent {\\n  id            String            @id @default(cuid())\\n  businessId    String?\\n  phoneNumberId String?\\n  type          WhatsAppEventType\\n  message       String\\n  latencyMs     Int?\\n  createdAt     DateTime          @default(now())\\n\\n  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)\\n\\n  @@index([businessId, createdAt])\\n  @@index([phoneNumberId, createdAt])\\n}\\n\\\"\\\"\\\"\\nopen(p,'w').write(s)\\nEOF\\nnpx prisma format 2>&1 | tail -1 && npx prisma migrate diff --from-schema-datamodel /tmp/opencode/pre-team-schema.prisma --to-schema-datamodel prisma/schema.prisma --script 2>/dev/null > /tmp/opencode/team.sql && cat /tmp/opencode/team.sql\"]" cwd=/home/sleeky3750/pulse-web http.span=2843899 role=server
