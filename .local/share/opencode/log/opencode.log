timestamp=2026-10-07T06:58:47.876Z level=INFO run=bd475466 message="spawning process" command=/bin/bash args="[\"-c\",\"python3 - <<'EOF'\\ndef edit(p, pairs):\\n    s=open(p).read()\\n    for old,new in pairs:\\n        assert s.count(old)==1, (p, old[:70])\\n        s=s.replace(old,new)\\n    open(p,'w').write(s)\\nedit('lib/ai/services/whatsappSupport.ts',[\\n('''import { KNOWLEDGE_PROMPT_BUDGET } from \\\"../staffConfig\\\";''','''import { applyKnowledgeBudget, formatKnowledgeEntry } from \\\"../knowledgeBudget\\\";'''),\\n('''  if (knowledge.length > 0) {\\n    let budget = KNOWLEDGE_PROMPT_BUDGET;\\n    const lines: string[] = [];\\n\\n    for (const entry of knowledge) {\\n      const line = `### ${entry.title.trim()}\\\\\\\\n${entry.content.trim()}`;\\n      if (line.length > budget) break;\\n      lines.push(line);\\n      budget -= line.length;\\n    }\\n\\n    sections.push(`Business knowledge:\\\\\\\\n${lines.join(\\\"\\\\\\\\n\\\\\\\\n\\\")}`);\\n  }''','''  const { included } = applyKnowledgeBudget(knowledge);\\n\\n  if (included.length > 0) {\\n    sections.push(\\n      `Business knowledge:\\\\\\\\n${included.map(formatKnowledgeEntry).join(\\\"\\\\\\\\n\\\\\\\\n\\\")}`\\n    );\\n  }'''),\\n])\\nedit('lib/ai/staffConfig.ts',[\\n('''/** Total knowledge characters sent to the model, to bound prompt size/cost. */\\nexport const KNOWLEDGE_PROMPT_BUDGET = 12_000;\\n''','''export { KNOWLEDGE_PROMPT_BUDGET } from \\\"./knowledgeBudget\\\";\\n'''),\\n])\\nedit('app/api/settings/knowledge/route.ts',[\\n('''import { knowledgeEntrySchema, toKnowledgeItem } from \\\"@/lib/settings/knowledge\\\";''','''import { knowledgeEntrySchema, toKnowledgeItem } from \\\"@/lib/settings/knowledge\\\";\\nimport { applyKnowledgeBudget } from \\\"@/lib/ai/knowledgeBudget\\\";'''),\\n('''    const entries = await prisma.knowledgeEntry.findMany({\\n      where: { businessId: guard.ctx.business.id },\\n      orderBy: { updatedAt: \\\"desc\\\" },\\n    });\\n\\n    return NextResponse.json({ success: true, entries: entries.map(toKnowledgeItem) });''','''    // Same ordering as loadAiStaffConfig, so the budget matches what the AI sees.\\n    const entries = await prisma.knowledgeEntry.findMany({\\n      where: { businessId: guard.ctx.business.id },\\n      orderBy: { updatedAt: \\\"desc\\\" },\\n    });\\n\\n    const budget = applyKnowledgeBudget(entries);\\n    const excludedIds = new Set(budget.excluded.map((entry) => entry.id));\\n\\n    return NextResponse.json({\\n      success: true,\\n      entries: entries.map((entry) => ({\\n        ...toKnowledgeItem(entry),\\n        inPrompt: !excludedIds.has(entry.id),\\n      })),\\n      promptBudget: {\\n        usedChars: budget.usedChars,\\n        limit: budget.limit,\\n        excludedCount: budget.excluded.length,\\n      },\\n    });'''),\\n])\\nedit('lib/settings/knowledge.ts',[\\n('''export interface KnowledgeItem {\\n  id: string;\\n  title: string;\\n  content: string;\\n  updatedAt: string;\\n}''','''export interface KnowledgeItem {\\n  id: string;\\n  title: string;\\n  content: string;\\n  updatedAt: string;\\n  /** False when the entry falls outside the AI prompt budget (GET only). */\\n  inPrompt?: boolean;\\n}\\n\\nexport interface KnowledgePromptBudget {\\n  usedChars: number;\\n  limit: number;\\n  excludedCount: number;\\n}'''),\\n])\\nEOF\\ngrep -n \\\"loadAiStaffConfig\\\\|orderBy\\\" lib/ai/staffConfig.ts\"]" cwd=/home/sleeky3750/pulse-web http.span=4552927 role=server
