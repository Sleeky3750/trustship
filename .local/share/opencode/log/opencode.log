timestamp=2026-10-07T05:35:36.007Z level=INFO run=9ad1a2a0 message="spawning process" command=/bin/bash args="[\"-c\",\"python3 - <<'EOF'\\np='components/console/team/IntegrationPanel.tsx'\\ns=open(p).read()\\ndef rep(old,new):\\n    global s\\n    assert s.count(old)==1, old[:70]\\n    s=s.replace(old,new)\\nrep('''import { CheckCircle2, KeyRound, Save, ShieldAlert, XCircle } from \\\"lucide-react\\\";''','''import { Activity, CheckCircle2, KeyRound, Save, ShieldAlert, XCircle } from \\\"lucide-react\\\";''')\\nrep('''      <div className=\\\"space-y-6\\\">\\n        <Panel className=\\\"p-5\\\">\\n          <h3 className=\\\"text-sm font-semibold text-zinc-50\\\">Webhook</h3>''','''      <div className=\\\"space-y-6\\\">\\n        {settings.connection && <ConnectionCheckCard />}\\n\\n        <Panel className=\\\"p-5\\\">\\n          <h3 className=\\\"text-sm font-semibold text-zinc-50\\\">Webhook</h3>''')\\nrep('''            <EnvRow ok={settings.environment.groqConfigured} label=\\\"GROQ_API_KEY\\\" hint=\\\"AI replies\\\" />''','''            <EnvRow ok={settings.environment.groqConfigured} label=\\\"GROQ_API_KEY\\\" hint=\\\"AI replies\\\" />\\n            <EnvRow\\n              ok={settings.environment.signatureVerificationConfigured}\\n              label=\\\"META_APP_SECRET\\\"\\n              hint=\\\"Verifies webhook signatures\\\"\\n            />''')\\ns += '''\\ninterface ConnectionCheckResult {\\n  checkedAt: string;\\n  phoneNumber: { ok: boolean; message: string; displayPhoneNumber: string | null };\\n  token: { state: string; message: string; expiresAt: string | null };\\n}\\n\\nfunction ConnectionCheckCard() {\\n  const [result, setResult] = useState<ConnectionCheckResult | null>(null);\\n  const [checking, setChecking] = useState(false);\\n\\n  async function run() {\\n    setChecking(true);\\n    try {\\n      const response = await fetch(\\\"/api/whatsapp/settings/check\\\", { method: \\\"POST\\\" });\\n      const data = await response.json().catch(() => ({}));\\n      if (!response.ok || !data.success) throw new Error(data.message || \\\"Check failed.\\\");\\n      setResult(data.check);\\n    } catch (err) {\\n      toast.error(err instanceof Error ? err.message : \\\"Check failed.\\\");\\n    } finally {\\n      setChecking(false);\\n    }\\n  }\\n\\n  const tokenOk = result?.token.state === \\\"valid\\\";\\n\\n  return (\\n    <Panel className=\\\"p-5\\\">\\n      <div className=\\\"flex items-center justify-between gap-3\\\">\\n        <h3 className=\\\"text-sm font-semibold text-zinc-50\\\">Connection status</h3>\\n        <button onClick={() => void run()} disabled={checking} className={buttonStyles.secondary}>\\n          <Activity className={checking ? \\\"h-4 w-4 motion-safe:animate-pulse\\\" : \\\"h-4 w-4\\\"} />\\n          {checking ? \\\"Checking…\\\" : \\\"Test connection\\\"}\\n        </button>\\n      </div>\\n      {result ? (\\n        <ul className=\\\"mt-4 space-y-3 text-sm motion-safe:animate-fade-in\\\">\\n          <li className=\\\"flex items-start gap-2.5\\\">\\n            {result.phoneNumber.ok ? (\\n              <CheckCircle2 className=\\\"mt-0.5 h-4 w-4 shrink-0 text-emerald-400\\\" />\\n            ) : (\\n              <XCircle className=\\\"mt-0.5 h-4 w-4 shrink-0 text-red-400\\\" />\\n            )}\\n            <div>\\n              <p className=\\\"text-zinc-200\\\">\\n                Phone number{result.phoneNumber.displayPhoneNumber ? ` ${result.phoneNumber.displayPhoneNumber}` : \\\"\\\"}\\n              </p>\\n              <p className=\\\"text-xs text-zinc-500\\\">{result.phoneNumber.message}</p>\\n            </div>\\n          </li>\\n          <li className=\\\"flex items-start gap-2.5\\\">\\n            {tokenOk ? (\\n              <CheckCircle2 className=\\\"mt-0.5 h-4 w-4 shrink-0 text-emerald-400\\\" />\\n            ) : (\\n              <ShieldAlert className=\\\"mt-0.5 h-4 w-4 shrink-0 text-amber-400\\\" />\\n            )}\\n            <div>\\n              <p className=\\\"capitalize text-zinc-200\\\">Access token: {result.token.state}</p>\\n              <p className=\\\"text-xs text-zinc-500\\\">{result.token.message}</p>\\n            </div>\\n          </li>\\n          <li className=\\\"text-xs text-zinc-600\\\">Checked {formatRelative(result.checkedAt)}</li>\\n        </ul>\\n      ) : (\\n        <p className=\\\"mt-2 text-xs text-zinc-500\\\">\\n          Runs a live check of your stored credentials against Meta.\\n        </p>\\n      )}\\n    </Panel>\\n  );\\n}\\n'''\\nopen(p,'w').write(s)\\nEOF\\ngrep -n \\\"tokenLast4\\\" components/console/team/IntegrationPanel.tsx | head -3\"]" cwd=/home/sleeky3750/pulse-web role=server
