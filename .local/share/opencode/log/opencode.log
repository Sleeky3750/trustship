timestamp=2026-10-07T22:52:18.092Z level=INFO run=4e9e1a6b message="spawning process" command=/bin/bash args="[\"-c\",\"cat > /tmp/campaigns_table_new.txt << 'ENDTEMPLATE'\\n\\\"use client\\\";\\n\\nimport { useState, useEffect } from \\\"react\\\";\\nimport { Badge } from \\\"@/components/console/ui\\\";\\nimport { useDebounce } from \\\"@/lib/utils\\\";\\nimport { prisma } from \\\"@/lib/prisma\\\";\\nimport { CrmTag, tagLabels } from \\\"@/lib/constants/crmTags\\\";\\n\\nexport interface CampaignsTableProps {\\n  businessId: string;\\n}\\n\\nexport default function CampaignsTable({ businessId }: CampaignsTableProps) {\\n  const [campaigns, setCampaigns] = useState<\\n    {\\n      id: string;\\n      title: string;\\n      status: \\\"DRAFT\\\" | \\\"SCHEDULED\\\" | \\\"COMPLETED\\\" | \\\"FAILED\\\";\\n      targetTags: string[];\\n      templatePreview: string;\\n      createdAt: Date;\\n      recipientCount: number;\\n      deliveredCount: number;\\n    }[]\\n  >([]);\\n  const [filterTag, setFilterTag] = useState<string | null>(null);\\n  const [search, setSearch] = useState(\\\"\\\");\\n\\n  const debouncedSearch = useDebounce(search, 300);\\n\\n  useEffect(() => {\\n    fetchCampaigns();\\n  }, [businessId]);\\n\\n  async function fetchCampaigns() {\\n    try {\\n      const campaigns = await prisma.campaign.findMany({\\n        where: { businessId },\\n        orderBy: { createdAt: \\\"desc\\\" },\\n        take: 20,\\n        include: {\\n          recipients: {\\n            select: {\\n              status: true,\\n            },\\n          },\\n        },\\n      });\\n\\n      const data = campaigns.map((c) => {\\n        const recipients = c.recipients;\\n        const total = recipients.length;\\n        const delivered = recipients.filter((r) => r.status === \\\"SENT\\\").length;\\n\\n        const templatePreview = c.templateMessage\\n          ? c.templateMessage.substring(0, 40) + (c.templateMessage.length > 40 ? \\\"...\\\" : \\\"\\\")\\n          : \\\"\\\";\\n\\n        return {\\n          id: c.id,\\n          title: c.title,\\n          status: c.status,\\n          targetTags: c.targetTags,\\n          templatePreview,\\n          createdAt: c.createdAt,\\n          recipientCount: total,\\n          deliveredCount: delivered,\\n        };\\n      });\\n\\n      setCampaigns(data);\\n    } catch (error) {\\n      console.error(\\\"Failed to fetch campaigns:\\\", error);\\n    }\\n  }\\n\\n  // Filter campaigns by tag\\n  const filteredCampaigns = campaigns.filter((campaign) => {\\n    if (!filterTag) return true;\\n    return campaign.targetTags.includes(filterTag);\\n  });\\n\\n  // Filter by search\\n  const searchLower = debouncedSearch.toLowerCase();\\n  const searchFiltered = filteredCampaigns.filter((campaign) => {\\n    return (\\n      campaign.title.toLowerCase().includes(searchLower) ||\\n      campaign.status.toLowerCase().includes(searchLower)\\n    );\\n  });\\n\\n  // Compute tag filter options\\n  const tagFilterOptions = [\\n    { value: \\\"all\\\", label: \\\"All Campaigns\\\" },\\n    ...Object.values(CrmTag).map((tag) => ({\\n      value: `tag:${tag}`,\\n      label: tagLabels[tag as keyof typeof tagLabels] || tag,\\n    })),\\n  ];\\n\\n  return (\\n    <div className=\\\"space-y-4\\\">\\n      {/* Filter toolbar */}\\n      <div className=\\\"flex flex-col sm:flex-row gap-3 flex-wrap\\\">\\n        <select\\n          value={filterTag}\\n          onChange={(e) => setFilterTag(e.target.value as any)}\\n          className=\\\"rounded-xl border border-zinc-700 bg-zinc-950/50 px-3 py-2 text-sm text-zinc-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500/60\\\"\\n        >\\n          {tagFilterOptions.map((opt) => (\\n            <option key={opt.value} value={opt.value}>\\n              {opt.label}\\n            </option>\\n          ))}\\n        </select>\\n\\n        <input\\n          value={search}\\n          onChange={(e) => setSearch(e.target.value)}\\n          placeholder=\\\"Search campaigns...\\\"\\n          className=\\\"flex-1 rounded-xl border border-zinc-700 bg-zinc-950/50 px-3 py-2 text-sm text-zinc-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500/60\\\"\\n        />\\n\\n        <button\\n          onClick={() => setFilterTag(null)}\\n          className=\\\"rounded-xl border border-zinc-700 bg-zinc-950/50 px-3 py-2 text-sm text-zinc-400 hover:bg-zinc-900 disabled:opacity-50\\\"\\n        >\\n          Clear\\n        </button>\\n      </div>\\n\\n      {/* Campaigns table */}\\n      <table className=\\\"w-full rounded-xl border border-zinc-800 bg-zinc-950/50 backdrop-blur-md\\\">\\n        <thead>\\n          <tr className=\\\"border-b border-zinc-800/80 bg-zinc-900/50 text-sm text-zinc-400\\\">\\n            <th className=\\\"w-24 px-3 py-3 font-medium\\\">Title</th>\\n            <th className=\\\"px-3 py-3\\\">Status</th>\\n            <th className=\\\"px-3 py-3\\\">Target</th>\\n            <th className=\\\"px-3 py-3\\\">Template</th>\\n            <th className=\\\"text-right px-3 py-3\\\">Sent</th>\\n            <th className=\\\"text-right px-3 py-3\\\">Total</th>\\n            <th className=\\\"px-3 py-3\\\"></th>\\n          </tr>\\n        </thead>\\n        <tbody>\\n          {searchFiltered.map((campaign) => {\\n            const statusBadges: React.React[] = [];\\n            if (campaign.status === \\\"DRAFT\\\") {\\n              statusBadges.push(\\n                <Badge key=\\\"draft\\\" variant=\\\"outline\\\" className=\\\"text-xs\\\">\\n                  Draft\\n                </Badge>\\n              );\\n            }\\n            if (campaign.status === \\\"SCHEDULED\\\") {\\n              statusBadges.push(\\n                <Badge key=\\\"scheduled\\\" variant=\\\"outline\\\" className=\\\"text-xs\\\">\\n                  Scheduled\\n                </Badge>\\n              );\\n            }\\n            if (campaign.status === \\\"COMPLETED\\\") {\\n              statusBadges.push(\\n                <Badge key=\\\"completed\\\" variant=\\\"outline\\\" className=\\\"text-xs\\\">\\n                  Completed\\n                </Badge>\\n              );\\n            }\\n            if (campaign.status === \\\"FAILED\\\") {\\n              statusBadges.push(\\n                <Badge key=\\\"failed\\\" variant=\\\"outline\\\" className=\\\"text-xs\\\">\\n                  Failed\\n                </Badge>\\n              );\\n            }\\n\\n            const tagBadges = campaign.targetTags.map(\\n              (tag) =>\\n                <Badge\\n                  key={tag}\\n                  variant=\\\"outline\\\"\\n                  className=\\\"text-xs margin-y-0.5\\\"\\n                >\\n                  {tagLabels[tag as keyof typeof tagLabels] || tag}\\n                </Badge>\\n            );\\n\\n            return (\\n              <tr\\n                key={campaign.id}\\n                className=\\\"hover:bg-zinc-900/30 transition-colors\\\"\\n              >\\n                <td className=\\\"font-medium px-3 py-3\\\">\\n                  {campaign.title}\\n                </td>\\n                <td className=\\\"px-3 py-3\\\">\\n                  {statusBadges}\\n                </td>\\n                <td className=\\\"px-3 py-3\\\">\\n                  {tagBadges.length > 0 ? (\\n                    <div className=\\\"flex gap-1\\\">{tagBadges}</div>\\n                  ) : (\\n                    <span className=\\\"text-xs text-zinc-500\\\">—</span>\\n                  )}\\n                </td>\\n                <td className=\\\"px-3 py-3\\\">{campaign.templatePreview}</td>\\n                <td className=\\\"text-right px-3 py-3\\\">\\n                  {campaign.deliveredCount}\\n                </td>\\n                <td className=\\\"text-right px-3 py-3\\\">\\n                  {campaign.recipientCount}\\n                </td>\\n                <td className=\\\"px-3 py-3\\\">\\n                  <button\\n                    className=\\\"rounded-lg border border-zinc-700 bg-zinc-950/50 px-2 py-1 text-sm text-zinc-400 hover:bg-zinc-900 disabled:opacity-50\\\"\\n                    aria-label=\\\"View campaign details\\\"\\n                  >\\n                    <svg\\n                      xmlns=\\\"http://www.w3.org/2000/svg\\\"\\n                      className=\\\"h-4 w-4 text-zinc-400\\\"\\n                      viewBox=\\\"0 0 24 24\\\"\\n                      fill=\\\"currentColor\\\"\\n                    >\\n                      <path\\n                        d=\\\"M10.3 5.7A1.5 1.5 0 0 1 11.5 5h3a1.5 1.5 0 0 1 0 3h-3a1.5 1.5 0 0 1-1.2-.7l-1.7 4.3A1.5 1.5 0 0 0 15 18.5h-5a1.5 1.5 0 0 0-1.2.7l-1.6-4.3A1.5 1.5 0 0 1 7.5 5h3.8l.3 1.2zM12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm0-2a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm-2-4.2a1.9 1.9 0 0 1 0-3.4 1.9 1.9 0 0 1 3.4 0 1.9 1.9 0 0 1-.06.1L15 9.5l-.7 2.7a1.9 1.9 0 0 1-3.4 0 1.9 1.9 0 0 1-.06-.1L9.5 11.8 7.4 8.6a1.9 1.9 0 0 1-.06-3.4z\\\"\\n                      />\\n                    </svg>\\n                  </button>\\n                </td>\\n              </tr>\\n            );\\n          })}\\n          {campaigns.length === 0 && (\\n            <tr>\\n              <td colSpan={7} className=\\\"p-8 text-center text-zinc-500\\\">\\n                No campaigns yet.\\n                <button\\n                  className=\\\"rounded-lg border border-zinc-700 bg-zinc-950/50 px-2 py-1 text-sm text-zinc-400 hover:bg-zinc-900\\\"\\n                >\\n                  Create your first broadcast\\n                </button>\\n              </td>\\n            </tr>\\n          )}\\n        </tbody>\\n      </table>\\n    </div>\\n  );\\n}\\nENDTEMPLATE\\ncat /tmp/campaigns_table_new.txt > components/console/campaigns/CampaignsTable.tsx\"]" cwd=/home/sleeky3750/pulse-web http.span=18172261 role=server
