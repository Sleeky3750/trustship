timestamp=2026-10-07T07:00:00.662Z level=INFO run=bd475466 message="spawning process" command=/bin/bash args="[\"-c\",\"python3 - <<'EOF'\\np='app/api/webhooks/whatsapp/route.ts'\\ns=open(p).read()\\ndef rep(old,new):\\n    global s\\n    assert s.count(old)==1, old[:80]\\n    s=s.replace(old,new)\\n\\nrep('''import { loadAiStaffConfig } from \\\"@/lib/ai/staffConfig\\\";''','''import { loadAiStaffConfig } from \\\"@/lib/ai/staffConfig\\\";\\nimport { mediaLabel, mediaMessageType, mediaNoticeText } from \\\"@/lib/whatsapp/media\\\";''')\\n\\nrep('''/** Logs an event after the response is sent''','''/** Validated subset of a Meta webhook non-text (media/location/etc.) message. */\\ninterface IncomingMediaMessage {\\n  id: string | null;\\n  from: string;\\n  /** Normalized Meta type, e.g. \\\"image\\\", \\\"audio\\\", \\\"document\\\", \\\"location\\\". */\\n  label: string;\\n  timestamp: Date;\\n}\\n\\n/** Logs an event after the response is sent''')\\n\\nrep('''        for (const rawMessage of rawMessages) {\\n          const message = parseTextMessage(rawMessage);\\n\\n          if (!message) {\\n            console.log(\\\"[WhatsApp Webhook] Ignored non-text message event\\\");\\n            continue;\\n          }\\n''','''        for (const rawMessage of rawMessages) {\\n          const message = parseTextMessage(rawMessage);\\n\\n          if (!message) {\\n            const media = parseMediaMessage(rawMessage);\\n\\n            if (media) {\\n              await handleMediaNotice(phoneNumberId, connection, media, profileName);\\n            } else {\\n              console.log(\\\"[WhatsApp Webhook] Ignored message event (reaction/system/invalid)\\\");\\n            }\\n            continue;\\n          }\\n''')\\n\\n# extract ensureConversation\\nold_block='''  const customer = await prisma.customer.upsert({\\n    where: {\\n      businessId_waId: {\\n        businessId: connection.businessId,\\n        waId: message.from,\\n      },\\n    },\\n    create: {\\n      businessId: connection.businessId,\\n      waId: message.from,\\n      phoneNumber: message.from,\\n      profileName,\\n    },\\n    update: {\\n      profileName: profileName ?? undefined,\\n    },\\n  });\\n\\n  const conversation = await prisma.conversation.findFirst({\\n    where: {\\n      businessId: connection.businessId,\\n      customerId: customer.id,\\n      whatsappConnectionId: connection.id,\\n      status: \\\"OPEN\\\",\\n    },\\n    orderBy: {\\n      updatedAt: \\\"desc\\\",\\n    },\\n  });\\n\\n  const activeConversation =\\n    conversation ??\\n    (await prisma.conversation.create({\\n      data: {\\n        businessId: connection.businessId,\\n        customerId: customer.id,\\n        whatsappConnectionId: connection.id,\\n        status: \\\"OPEN\\\",\\n        mode: \\\"AI\\\",\\n      },\\n    }));\\n'''\\nrep(old_block,'''  const { customer, conversation: activeConversation } = await ensureConversation(\\n    connection,\\n    message.from,\\n    profileName\\n  );\\n''')\\n\\ns += '''\\n/** Upserts the Customer and returns their OPEN conversation (creating one if needed). */\\nasync function ensureConversation(\\n  connection: WhatsAppConnection,\\n  waId: string,\\n  profileName: string | null\\n) {\\n  const customer = await prisma.customer.upsert({\\n    where: {\\n      businessId_waId: {\\n        businessId: connection.businessId,\\n        waId,\\n      },\\n    },\\n    create: {\\n      businessId: connection.businessId,\\n      waId,\\n      phoneNumber: waId,\\n      profileName,\\n    },\\n    update: {\\n      profileName: profileName ?? undefined,\\n    },\\n  });\\n\\n  const existing = await prisma.conversation.findFirst({\\n    where: {\\n      businessId: connection.businessId,\\n      customerId: customer.id,\\n      whatsappConnectionId: connection.id,\\n      status: \\\"OPEN\\\",\\n    },\\n    orderBy: { updatedAt: \\\"desc\\\" },\\n  });\\n\\n  const conversation =\\n    existing ??\\n    (await prisma.conversation.create({\\n      data: {\\n        businessId: connection.businessId,\\n        customerId: customer.id,\\n        whatsappConnectionId: connection.id,\\n        status: \\\"OPEN\\\",\\n        mode: \\\"AI\\\",\\n      },\\n    }));\\n\\n  return { customer, conversation };\\n}\\n\\nfunction parseMediaMessage(raw: unknown): IncomingMediaMessage | null {\\n  if (!raw || typeof raw !== \\\"object\\\") {\\n    return null;\\n  }\\n\\n  const message = raw as {\\n    id?: unknown;\\n    from?: unknown;\\n    type?: unknown;\\n    timestamp?: unknown;\\n  };\\n\\n  const label = mediaLabel(message.type);\\n\\n  if (!label || typeof message.from !== \\\"string\\\" || !message.from) {\\n    return null;\\n  }\\n\\n  return {\\n    id: typeof message.id === \\\"string\\\" && message.id ? message.id : null,\\n    from: message.from,\\n    label,\\n    timestamp: parseMetaTimestamp(message.timestamp),\\n  };\\n}\\n\\n/**\\n * Records an inbound media/location/etc. message as a system notice in the\\n * thread, so agents see the customer sent something Pulse can't read yet.\\n * No AI reply is generated. Stored as an INBOUND SYSTEM message, so it counts\\n * toward unread badges but is excluded from AI history.\\n */\\nasync function handleMediaNotice(\\n  phoneNumberId: string,\\n  connection: WhatsAppConnection | null,\\n  media: IncomingMediaMessage,\\n  profileName: string | null\\n) {\\n  const notice = mediaNoticeText(media.label);\\n\\n  logLater({\\n    type: \\\"WEBHOOK_RECEIVED\\\",\\n    businessId: connection?.businessId,\\n    phoneNumberId,\\n    message: `Unsupported ${media.label} message received from ${maskPhone(media.from)}`,\\n  });\\n\\n  if (connection) {\\n    try {\\n      const { conversation } = await ensureConversation(connection, media.from, profileName);\\n\\n      if (media.id) {\\n        const existing = await prisma.message.findUnique({\\n          where: { externalId: media.id },\\n          select: { id: true },\\n        });\\n        if (existing) return; // Meta redelivery\\n      }\\n\\n      await prisma.message.create({\\n        data: {\\n          conversationId: conversation.id,\\n          businessId: connection.businessId,\\n          externalId: media.id,\\n          direction: \\\"INBOUND\\\",\\n          sender: \\\"SYSTEM\\\",\\n          type: mediaMessageType(media.label),\\n          text: notice,\\n          status: \\\"RECEIVED\\\",\\n          createdAt: media.timestamp,\\n        },\\n      });\\n\\n      await prisma.conversation.update({\\n        where: { id: conversation.id },\\n        data: { lastMessageAt: new Date() },\\n      });\\n      return;\\n    } catch (error) {\\n      console.error(\\n        \\\"[WhatsApp Webhook] Failed to record media notice, using fallback log:\\\",\\n        error instanceof Error ? error.message : error\\n      );\\n    }\\n  }\\n\\n  // No connection (or DB failure above): keep a record in the fallback log.\\n  await saveInboundWhatsAppMessage({\\n    phoneNumberId,\\n    senderPhoneNumber: media.from,\\n    messageBody: notice,\\n    wamid: media.id,\\n    timestamp: media.timestamp,\\n  });\\n}\\n'''\\nopen(p,'w').write(s)\\nEOF\"]" cwd=/home/sleeky3750/pulse-web http.span=4625713 role=server
