ort { markThreadRead, normalizePhone } from \\\"@/lib/whatsapp/inbox\\\";\\nimport { parseJsonBody } from \\\"@/lib/security/request\\\";\\n\\nconst readSchema = z.object({ phone: z.string().max(32) });'''),\\n('''    const body = await request.json().catch(() => null);\\n    const phone = normalizePhone(body?.phone);''','''    const parsed = await parseJsonBody(request, readSchema);\\n    if (!parsed.ok) return parsed.response;\\n\\n    const phone = normalizePhone(parsed.data.phone);'''),\\n])\\n\\n# conversations/[id]\\nedit('app/api/whatsapp/conversations/[id]/route.ts', [\\n('''import { updateConversation } from \\\"@/lib/whatsapp/inbox\\\";''','''import { updateConversation } from \\\"@/lib/whatsapp/inbox\\\";\\nimport { parseJsonBody } from \\\"@/lib/security/request\\\";'''),\\n('''    const parsed = updateSchema.safeParse(\\n      await request.json().catch(() => null)\\n    );\\n\\n    if (!parsed.success) {\\n      return NextResponse.json(\\n        {\\n          success: false,\\n          message: parsed.error.issues[0]?.message ?? \\\"Invalid request.\\\",\\n        },\\n        { status: 400 }\\n      );\\n    }\\n''','''    const parsed = await parseJsonBody(request, updateSchema);\\n    if (!parsed.ok) return parsed.response;\\n'''),\\n('''    assignedMemberId: z.string().min(1).nullable().optional(),''','''    assignedMemberId: z.string().min(1).max(64).nullable().optional(),'''),\\n])\\n\\n# settings PUT\\nedit('app/api/whatsapp/settings/route.ts', [\\n('''} from \\\"@/lib/whatsapp/settings\\\";''','''} from \\\"@/lib/whatsapp/settings\\\";\\nimport { parseJsonBody } from \\\"@/lib/security/request\\\";\\nimport { enforceRateLimits, MINUTE } from \\\"@/lib/security/rateLimit\\\";'''),\\n('''    const parsed = settingsSchema.safeParse(\\n      await request.json().catch(() => null)\\n    );\\n\\n    if (!parsed.success) {\\n      return NextResponse.json(\\n        {\\n          success: false,\\n          message: parsed.error.issues[0]?.message ?? \\\"Invalid request.\\\",\\n        },\\n        { status: 400 }\\n      );\\n    }\\n''','''    // Each save calls Meta to verify credentials.\\n    const limited = await enforceRateLimits([\\n      { name: \\\"settings:whatsapp\\\", id: guard.ctx.business.id, limit: 10, windowMs: MINUTE },\\n    ]);\\n    if (limited) return limited;\\n\\n    const parsed = await parseJsonBody(request, settingsSchema);\\n    if (!parsed.ok) return parsed.response;\\n'''),\\n])\\n\\n# invites\\nedit('app/api/team/invites/route.ts', [\\n('''import { appOrigin } from \\\"@/lib/http\\\";''','''import { appOrigin } from \\\"@/lib/http\\\";\\nimport { parseJsonBody } from \\\"@/lib/security/request\\\";\\nimport { enforceRateLimits, HOUR } from \\\"@/lib/security/rateLimit\\\";'''),\\n('''    const parsed = inviteSchema.safeParse(\\n      await request.json().catch(() => null)\\n    );\\n\\n    if (!parsed.success) {\\n      return NextResponse.json(\\n        {\\n          success: false,\\n          message: parsed.error.issues[0]?.message ?? \\\"Invalid request.\\\",\\n        },\\n        { status: 400 }\\n      );\\n    }\\n''','''    const limited = await enforceRateLimits([\\n      { name: \\\"invite:create\\\", id: guard.ctx.business.id, limit: 30, windowMs: HOUR },\\n    ]);\\n    if (limited) return limited;\\n\\n    const parsed = await parseJsonBody(request, inviteSchema);\\n    if (!parsed.ok) return parsed.response;\\n'''),\\n('''  email: z.string().trim().toLowerCase().email(\\\"Enter a valid email address.\\\"),''','''  email: z.string().trim().toLowerCase().email(\\\"Enter a valid email address.\\\").max(254),'''),\\n])\\n\\n# members/[id]\\nedit('app/api/team/members/[id]/route.ts', [\\n('''import { removeMember, updateMemberRole } from \\\"@/lib/team/service\\\";''','''import { removeMember, updateMemberRole } from \\\"@/lib/team/service\\\";\\nimport { parseJsonBody } from \\\"@/lib/security/request\\\";'''),\\n('''    const parsed = roleSchema.safeParse(await request.json().catch(() => null));\\n\\n    if (!parsed.success) {\\n      return NextResponse.json(\\n        { success: false, message: \\\"Choose a valid role.\\\" },\\n        { status: 400 }\\n      );\\n    }\\n''','''    const parsed = await parseJsonBody(request, roleSchema);\\n    if (!parsed.ok) return parsed.response;\\n'''),\\n])\\nEOF\\ngrep -rn \\\"request.json()\\\" app/api lib | grep -v node_modules\"]" cwd=/home/sleeky3750/pulse-web role=server
