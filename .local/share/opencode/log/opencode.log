timestamp=2026-10-07T05:35:14.225Z level=INFO run=9ad1a2a0 message="spawning process" command=/bin/bash args="[\"-c\",\"python3 - <<'EOF'\\ndef edit(p, pairs):\\n    s=open(p).read()\\n    for old,new in pairs:\\n        assert s.count(old)==1, (p, old[:70])\\n        s=s.replace(old,new)\\n    open(p,'w').write(s)\\nedit('lib/whatsapp/types.ts',[('''    groqConfigured: boolean;\\n  };''','''    groqConfigured: boolean;\\n    signatureVerificationConfigured: boolean;\\n  };''')])\\nedit('lib/whatsapp/settings.ts',[\\n('''import type { IntegrationSettings } from \\\"./types\\\";''','''import { getAccessTokenStatus } from \\\"./token\\\";\\nimport { isSignatureVerificationConfigured } from \\\"./signature\\\";\\nimport type { IntegrationSettings } from \\\"./types\\\";'''),\\n('''import { invalidateTokenStatus } from \\\"./token\\\";\\n''',''''''),\\n('''      groqConfigured: !!process.env.GROQ_API_KEY,''','''      groqConfigured: !!process.env.GROQ_API_KEY,\\n      signatureVerificationConfigured: isSignatureVerificationConfigured(),'''),\\n('''  invalidateTokenStatus(tokenToVerify);\\n''',''),\\n('''async function verifyPhoneNumber(''','''export interface ConnectionCheck {\\n  checkedAt: string;\\n  phoneNumber: { ok: boolean; message: string; displayPhoneNumber: string | null };\\n  token: { state: string; message: string; expiresAt: string | null };\\n}\\n\\n/** Live check of the stored credentials against Meta (no caching). */\\nexport async function checkConnection(\\n  businessId: string\\n): Promise<ConnectionCheck | null> {\\n  const connection = await prisma.whatsAppConnection.findFirst({\\n    where: { businessId },\\n    orderBy: { createdAt: \\\"asc\\\" },\\n  });\\n\\n  if (!connection) return null;\\n\\n  const token = decryptToken(connection.accessTokenEncrypted);\\n  const [phone, tokenStatus] = await Promise.all([\\n    token\\n      ? verifyPhoneNumber(connection.phoneNumberId, token)\\n      : Promise.resolve({ ok: false as const, error: \\\"The stored token couldn't be decrypted.\\\" }),\\n    getAccessTokenStatus(token, \\\"connection\\\", { fresh: true }),\\n  ]);\\n\\n  return {\\n    checkedAt: new Date().toISOString(),\\n    phoneNumber: phone.ok\\n      ? {\\n          ok: true,\\n          message: \\\"Meta recognises this phone number with the stored token.\\\",\\n          displayPhoneNumber: phone.displayPhoneNumber,\\n        }\\n      : { ok: false, message: phone.error, displayPhoneNumber: null },\\n    token: {\\n      state: tokenStatus.state,\\n      message: tokenStatus.message,\\n      expiresAt: tokenStatus.expiresAt,\\n    },\\n  };\\n}\\n\\nasync function verifyPhoneNumber('''),\\n])\\nedit('lib/whatsapp/token.ts',[\\n('''export async function getAccessTokenStatus(\\n  token: string | null,\\n  source: TokenSource\\n): Promise<AccessTokenStatus> {''','''export async function getAccessTokenStatus(\\n  token: string | null,\\n  source: TokenSource,\\n  options: { fresh?: boolean } = {}\\n): Promise<AccessTokenStatus> {'''),\\n('''  if (hit && Date.now() - hit.checkedAt < CACHE_TTL_MS) {''','''  if (!options.fresh && hit && Date.now() - hit.checkedAt < CACHE_TTL_MS) {'''),\\n('''/** Clears cached results, e.g. after an admin saves a new token. */\\nexport function invalidateTokenStatus(token: string) {\\n  cache.delete(createHash(\\\"sha256\\\").update(token).digest(\\\"hex\\\"));\\n}\\n''',''),\\n])\\nEOF\\ngrep -n \\\"invalidateTokenStatus\\\" -r lib app || echo ok\"]" cwd=/home/sleeky3750/pulse-web role=server
