timestamp=2026-10-07T02:43:31.424Z level=INFO run=e41d4e8e message="spawning process" command=/bin/bash args="[\"-c\",\"d=prisma/migrations/20261007140000_team_roles_and_events; mkdir -p $d && cp /tmp/opencode/team.sql $d/migration.sql && cat >> $d/migration.sql <<'EOF'\\n-- Backfill: every existing Business login becomes an OWNER User so current\\n-- credentials keep working. Emails are lowercased to match how /api/login\\n-- normalizes input; if two businesses share an email ignoring case, the\\n-- oldest business's password hash wins and the user owns both.\\nINSERT INTO \\\"User\\\" (\\\"id\\\", \\\"email\\\", \\\"password\\\", \\\"createdAt\\\", \\\"updatedAt\\\")\\nSELECT DISTINCT ON (lower(b.\\\"email\\\"))\\n  'usr_' || b.\\\"id\\\", lower(b.\\\"email\\\"), b.\\\"password\\\", b.\\\"createdAt\\\", CURRENT_TIMESTAMP\\nFROM \\\"Business\\\" b\\nORDER BY lower(b.\\\"email\\\"), b.\\\"createdAt\\\" ASC\\nON CONFLICT (\\\"email\\\") DO NOTHING;\\n\\nINSERT INTO \\\"TeamMember\\\" (\\\"id\\\", \\\"businessId\\\", \\\"userId\\\", \\\"email\\\", \\\"role\\\", \\\"status\\\", \\\"joinedAt\\\", \\\"createdAt\\\", \\\"updatedAt\\\")\\nSELECT 'tm_' || b.\\\"id\\\", b.\\\"id\\\", u.\\\"id\\\", u.\\\"email\\\", 'OWNER', 'ACTIVE', b.\\\"createdAt\\\", b.\\\"createdAt\\\", CURRENT_TIMESTAMP\\nFROM \\\"Business\\\" b\\nJOIN \\\"User\\\" u ON u.\\\"email\\\" = lower(b.\\\"email\\\")\\nON CONFLICT DO NOTHING;\\nEOF\\nnpx prisma generate 2>&1 | grep Generated\"]" cwd=/home/sleeky3750/pulse-web http.span=2878711 role=server
