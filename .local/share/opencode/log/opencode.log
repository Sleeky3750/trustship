timestamp=2026-10-09T10:09:09.998Z level=INFO run=36b0c2b3 message="spawning process" command=/bin/bash args="[\"-c\",\"cat > /home/sleeky3750/pulse-web/app/dashboard/catalog/page.tsx << 'ENDFILE'\\nimport { notFound } from \\\"next/navigation\\\";\\nimport { useState, useEffect, useCallback } from \\\"react\\\";\\nimport Link from \\\"next/link\\\";\\nimport { usePathname, useRouter } from \\\"next/navigation\\\";\\nimport { X } from \\\"lucide-react\\\";\\n\\nimport { cn } from \\\"@/lib/utils\\\";\\nimport { prisma } from \\\"@/lib/prisma\\\";\\nimport { useDebounce } from \\\"@/lib/utils\\\";\\n\\nimport { Badge } from \\\"@/components/console/ui\\\";\\nimport { CSVImportModal } from \\\"@/components/catalog/CSVImportModal\\\";\\n\\nexport const metadata = {\\n  title: \\\"Product Catalog\\\",\\n  description: \\\"Train your AI staff on live inventory and pricing in seconds\\\",\\n};\\n\\nexport default function CatalogPage() {\\n  const pathname = usePathname();\\n  const router = useRouter();\\n  const [search, setSearch] = useState(\\\"\\\");\\n  const [categoryFilter, setCategoryFilter] = useState<string | null>(null);\\n  const [stockFilter, setStockFilter] = useState<string | null>(\\\"all\\\");\\n  const [products, setProducts] = useState<Product[]>([]);\\n  const [loading, setLoading] = useState(true);\\n  const [error, setError] = useState<string | null>(null);\\n  const [showImportModal, setShowImportModal] = useState(false);\\n\\n  const debouncedSearch = useDebounce(search, 300);\\n\\n  useEffect(() => {\\n    fetchProducts();\\n  }, [debouncedSearch, categoryFilter, stockFilter]);\\n\\n  const ctx = useMemo(() => {\\n    return { business: { id: \\\"business_1\\\" } };\\n  }, []);\\n\\n  const fetchProducts = async () => {\\n    setLoading(true);\\n    setError(null);\\n    try {\\n      const where: any = {\\n        tenantId: ctx?.business?.id,\\n      };\\n\\n      if (debouncedSearch) {\\n        where.OR = [\\n          { name: { contains: debouncedSearch, mode: \\\"insensitive\\\" } },\\n          { description: { contains: debouncedSearch, mode: \\\"insensitive\\\" } },\\n        ];\\n      }\\n\\n      if (categoryFilter) {\\n        where.category = categoryFilter;\\n      }\\n\\n      if (stockFilter === \\\"in-stock\\\") {\\n        where.inStock = true;\\n      } else if (stockFilter === \\\"out-of-stock\\\") {\\n        where.inStock = false;\\n      }\\n\\n      const [totalProducts, inStockCount, outOfStockCount] = await Promise.all([\\n        prisma.product.count({ where }),\\n        prisma.product.count({ where: { ...where, inStock: true } }),\\n        prisma.product.count({ where: { ...where, inStock: false } }),\\n      ]);\\n\\n      const data = await prisma.product.findMany({\\n        where,\\n        orderBy: { createdAt: \\\"desc\\\" },\\n        take: 100,\\n      });\\n\\n      setProducts(data);\\n      setTotalProducts(totalProducts);\\n      setInStockCount(inStockCount);\\n      setOutOfStockCount(outOfStockCount);\\n    } catch (err) {\\n      setError(\\\"Failed to load products\\\");\\n      console.error(err);\\n    } finally {\\n      setLoading(false);\\n    }\\n  };\\n\\n  const handleImport = async (products: Product[]) => {\\n    setProducts((prev) => [...new Set([...prev, ...products])]);\\n    setError(null);\\n    setShowImportModal(false);\\n  };\\n\\n  return (\\n    <div className=\\\"flex h-full flex-col bg-zinc-950 text-zinc-100\\\">\\n      <header className=\\\"border-b border-zinc-800/60 bg-zinc-950/80 backdrop-blur-xl py-6\\\">\\n        <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6\\\">\\n          <div className=\\\"flex flex-col sm:flex-row items-center gap-4\\\">\\n            <div>\\n              <h1 className=\\\"text-2xl sm:text-3xl font-bold tracking-tight text-zinc-100\\\">\\n                Product Catalog\\n              </h1>\\n              <p className=\\\"text-zinc-400 text-sm\\\">\\n                Train your AI staff on live inventory and pricing in seconds\\n              </p>\\n            </div>\\n            <div className=\\\"flex items-center gap-2 sm:gap-3\\\">\\n              <Link\\n                href=\\\"/dashboard/campaigns\\\"\\n                className={cn(\\n                  \\\"inline-flex items-center gap-2 rounded-lg border border-zinc-700 bg-zinc-950/50 px-4 py-2 text-sm font-medium text-zinc-400 hover:bg-zinc-900 transition-colors\\\"\\n                )}\\n              >\\n                <svg\\n                  xmlns=\\\"http://www.w3.org/2000/svg\\\"\\n                  className=\\\"h-4 w-4\\\"\\n                  viewBox=\\\"0 0 24 24\\\"\\n                  fill=\\\"currentColor\\\"\\n                >\\n                  <path\\n                    d=\\\"M3 12l2-8h2l2-8 8 8h5v8H3v-8zm12 4h-2l-2 8 2 8h2l2-8zM3 8h2l2-8 8 8h5v8H3V8zm12-4h-2L7 3h2l7 8 2-8z\\\"\\n                  />\\n                </svg>\\n                Campaigns\\n              </Link>\\n              <button\\n                variant=\\\"primary\\\"\\n                onClick={() => setShowImportModal(true)}\\n                className=\\\"bg-indigo-600 hover:bg-indigo-500 text-zinc-950 px-4 py-2 rounded-lg font-medium transition-colors\\\"\\n              >\\n                Bulk Import CSV\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n      </header>\\n\\n      <div className=\\\"grid grid-cols-1 sm:grid-cols-3 gap-4 mt-4\\\">\\n        <MetricCard\\n          title=\\\"Total Products\\\"\\n          count={totalProducts || 0}\\n          accent=\\\"indigo\\\"\\n        />\\n        <MetricCard\\n          title=\\\"In Stock\\\"\\n          count={inStockCount || 0}\\n          accent=\\\"emerald\\\"\\n          status=\\\"positive\\\"\\n        />\\n        <MetricCard\\n          title=\\\"Out of Stock\\\"\\n          count={outOfStockCount || 0}\\n          accent=\\\"amber\\\"\\n          status=\\\"warning\\\"\\n        />\\n      </div>\\n\\n      {error && (\\n        <div className=\\\"mt-4 p-4 rounded-xl border-zinc-800/60 bg-zinc-900/60 text-zinc-300 text-sm\\\">\\n          <p className=\\\"font-medium\\\">{error}</p>\\n        </div>\\n      )}\\n\\n      <div className=\\\"mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\\\">\\n        <div>\\n          <label className=\\\"block text-sm text-zinc-400 mb-2\\\">Instant Search</label>\\n          <input\\n            type=\\\"text\\\"\\n            value={search}\\n            onChange={(e) => setSearch(e.target.value)}\\n            placeholder=\\\"Search products by name, SKU, or category...\\\"\\n            className=\\\"w-full rounded-lg border border-zinc-700 bg-zinc-950/50 px-4 py-3 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500/60 placeholder-zinc-500 transition-colors\\\"\\n            aria-label=\\\"Search products\\\"\\n          />\\n        </div>\\n\\n        <div>\\n          <label className=\\\"block text-sm text-zinc-400 mb-2\\\">Category</label>\\n          <select\\n            value={categoryFilter || \\\"all\\\"}\\n            onChange={(e) => setCategoryFilter(e.target.value as string)}\\n            className=\\\"w-full rounded-lg border border-zinc-700 bg-zinc-950/50 px-4 py-3 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500/60 placeholder-zinc-500\\\"\\n            aria-label=\\\"Filter by category\\\"\\n          >\\n            <option value=\\\"all\\\">All Categories</option>\\n            <option value=\\\"General\\\">General</option>\\n            <option value=\\\"Electronics\\\">Electronics</option>\\n            <option value=\\\"Clothing\\\">Clothing</option>\\n            <option value=\\\"Food\\\">Food</option>\\n            <option value=\\\"Services\\\">Services</option>\\n          </select>\\n        </div>\\n\\n        <div>\\n          <label className=\\\"block text-sm text-zinc-400 mb-2\\\">Stock Status</label>\\n          <select\\n            value={stockFilter || \\\"all\\\"}\\n            onChange={(e) => setStockFilter(e.target.value as string)}\\n            className=\\\"w-full rounded-lg border border-zinc-700 bg-zinc-950/50 px-4 py-3 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500/60 placeholder-zinc-500\\\"\\n            aria-label=\\\"Filter by stock status\\\"\\n          >\\n            <option value=\\\"all\\\">All Stock</option>\\n            <option value=\\\"in-stock\\\">In Stock</option>\\n            <option value=\\\"out-of-stock\\\">Out of Stock</option>\\n          </select>\\n        </div>\\n      </div>\\n\\n      <div className=\\\"mt-8\\\">\\n        {loading && (\\n          <div className=\\\"h-96 flex items-center justify-center\\\">\\n            <Skeleton className=\\\"h-6 w-24 rounded-blg\\\" />\\n            <Skeleton className=\\\"h-6 w-3/4 rounded-blg\\\" />\\n          </div>\\n        )}\\n\\n        {error && (\\n          <div className=\\\"mt-6 p-4 rounded-xl border-zinc-800/60 bg-zinc-900/60 text-zinc-300 text-sm\\\">\\n            <p>{error}</p>\\n          </div>\\n        )}\\n\\n        {!loading && products.length === 0 && (\\n          <div className=\\\"p-12 text-center text-zinc-500\\\">\\n            <svg\\n              xmlns=\\\"http://www.w3.org/2000/svg\\\"\\n              className=\\\"h-12 w-12 mx-auto mb-4 opacity-50\\\"\\n              viewBox=\\\"0 0 24 24\\\"\\n              fill=\\\"none\\\"\\n              stroke=\\\"currentColor\\\"\\n            >\\n              <path d=\\\"M21 15v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h11\\\" />\\n            </svg>\\n            <p className=\\\"text-zinc-500 mt-2\\\">No products found</p>\\n            <p className=\\\"text-zinc-400 text-sm mt-1\\\">\\n              Try adjusting your search or filter criteria\\n            </p>\\n          </div>\\n        )}\\n\\n        <ProductTable\\n          products={products}\\n          onEdit={handleEdit}\\n          onDelete={handleDelete}\\n          onStockToggle={handleStockToggle}\\n        />\\n      </div>\\n    </div>\\n  );\\n}\\n\\nfunction MetricCard({\\n  title,\\n  count,\\n  accent,\\n  status,\\n}: {\\n  title: string;\\n  count: number;\\n  accent: string;\\n  status?: \\\"positive\\\" | \\\"warning\\\";\\n}) {\\n  const statusColor = status === \\\"positive\\\" ? \\\"emerald-500\\\" : \\\"amber-500\\\";\\n  const statusBg = status === \\\"positive\\\" ? \\\"emerald-100\\\" : \\\"amber-100\\\";\\n\\n  return (\\n    <div className=\\\"rounded-xl border border-zinc-800/50 bg-zinc-950/80 p-5 backdrop-blur-md\\\">\\n      <p className=\\\"text-zinc-500 text-sm mb-1\\\">{title}</p>\\n      <p className=\\\"text-2xl font-bold text-zinc-100\\\">\\n        {count}\\n      </p>\\n      <Badge\\n        variant=\\\"outline\\\"\\n        className={`text-xs px-2 py-1 rounded mr-1 ${statusColor} bg-${statusBg}/20`}\\n      >\\n        {status || \\\"items\\\"}\\n      </Badge>\\n    </div>\\n  );\\n}\\n\\nfunction ProductTable({ products, onEdit, onDelete, onStockToggle }: any) {\\n  const [editing, setEditing] = useState<Product | null>(null);\\n\\n  const handleEdit = (product: Product) => setEditing(product);\\n  const handleDelete = async (id: string) => {\\n    if (confirm(\\\"Are you sure you want to delete this product?\\\")) {\\n      try {\\n        await prisma.product.delete({ where: { id } });\\n        setProducts((prev) => prev.filter((p) => p.id !== id));\\n      } catch (err) {\\n        console.error(err);\\n      }\\n    }\\n  };\\n\\n  const handleStockToggle = async (product: Product) => {\\n    try {\\n      await prisma.product.update({\\n        where: { id: product.id },\\n        data: {\\n          inStock: !product.inStock,\\n          stockQuantity: product.inStock ? 0 : product.stockQuantity + 1,\\n        },\\n      });\\n      setProducts((prev) =>\\n        prev.map((p) => (p.id === product.id ? { ...p, inStock: !p.inStock } : p))\\n      );\\n    } catch (err) {\\n      console.error(err);\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"overflow-x-auto rounded-xl border border-zinc-800/50 bg-zinc-950/80 backdrop-blur-md\\\">\\n      <table className=\\\"w-full min-w-max\\\">\\n        <thead>\\n          <tr className=\\\"border-b border-zinc-800/80 bg-zinc-900/50 text-zinc-400 text-sm\\\">\\n            <th className=\\\"py-4 text-left\\\">Image</th>\\n            <th className=\\\"py-4 text-left\\\">Product Name & SKU</th>\\n            <th className=\\\"py-4 text-left\\\">Category</th>\\n            <th className=\\\"py-4 text-right\\\">Price</th>\\n            <th className=\\\"py-4 text-center\\\">Stock Status</th>\\n            <th className=\\\"py-4 text-right actions\\\">Actions</th>\\n          </tr>\\n        </thead>\\n        <tbody>\\n          {products.map((product) => {\\n            const isEditing = editing?.id === product.id;\\n            return (\\n              <tr\\n                key={product.id}\\n                className={`hover:bg-zinc-900/30 transition-colors ${isEditing ? \\\"bg-zinc-900/50\\\" : \\\"\\\"}`}\\n              >\\n                <td className=\\\"py-6 px-4\\\">\\n                  {isEditing ? (\\n                    <input\\n                      type=\\\"text\\\"\\n                      value={product.imageUrl || \\\"\\\"}\\n                      onChange={(e) =>\\n                        setEditing((prev) => ({ ...prev, imageUrl: e.target.value }))\\n                      }\\n                      className=\\\"w-full bg-zinc-900 border border-zinc-700 rounded-lg px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-indigo-500/60\\\"\\n                    />\\n                  ) : (\\n                    <img\\n                      src={product.imageUrl || \\\"/placeholder-product.svg\\\"}\\n                      alt={product.name}\\n                      className=\\\"w-10 h-10 rounded-lg object-cover\\\"\\n                    />\\n                  )}\\n                </td>\\n                <td className=\\\"py-6 px-4\\\">\\n                  {isEditing ? (\\n                    <input\\n                      value={product.name}\\n                      onChange={(e) =>\\n                        setEditing((prev) => ({ ...prev, name: e.target.value }))\\n                      }\\n                      className=\\\"w-full bg-zinc-900 border border-zinc-700 rounded-lg px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-indigo-500/60\\\"\\n                    />\\n                  ) : (\\n                    <div className=\\\"flex items-center gap-2\\\">\\n                      <span className=\\\"font-medium text-zinc-100\\\">{product.name}</span>\\n                      {product.sku && (\\n                        <span className=\\\"text-zinc-500 text-xs\\\">(SKU: {product.sku})</span>\\n                      )}\\n                    </div>\\n                  )}\\n                </td>\\n                <td className=\\\"py-6 px-4\\\">\\n                  <Badge variant=\\\"outline\\\" className=\\\"text-xs px-2 py-1\\\">\\n                    {product.category}\\n                  </Badge>\\n                </td>\\n                <td className=\\\"py-6 px-4 text-right\\\">\\n                  {isEditing ? (\\n                    <input\\n                      type=\\\"number\\\"\\n                      value={product.price}\\n                      onChange={(e) =>\\n                        setEditing((prev) => ({ ...prev, price: parseFloat(e.target.value) || 0 }))\\n                      }\\n                      className=\\\"w-full bg-zinc-900 border border-zinc-700 rounded-lg px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-indigo-500/60\\\"\\n                    />\\n                  ) : (\\n                    `$${product.price.toFixed(2)}`\\n                  )}\\n                </td>\\n                <td className=\\\"py-6 px-4 text-center\\\">\\n                  {isEditing ? (\\n                    <select\\n                      value={product.inStock ? \\\"in-stock\\\" : \\\"out-of-stock\\\"}\\n                      onChange={(e) =>\\n                        setEditing((prev) => ({\\n                          ...prev,\\n                          inStock: e.target.value === \\\"in-stock\\\",\\n                        }))\\n                      }\\n                      className=\\\"w-full bg-zinc-900 border border-zinc-700 rounded-lg px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-indigo-500/60\\\"\\n                    >\\n                      <option value=\\\"in-stock\\\">In Stock</option>\\n                      <option value=\\\"out-of-stock\\\">Out of Stock</option>\\n                    </select>\\n                  ) : (\\n                    <span className=\\\"px-2 py-1 rounded text-xs ${product.inStock ? \\\"text-zinc-900 bg-emerald-100\\\" : \\\"text-zinc-900 bg-amber-100\\\"}\\\">\\n                      {product.inStock ? \\\"In Stock\\\" : \\\"Out of Stock\\\"}\\n                    </span>\\n                  )}\\n                </td>\\n                <td className=\\\"py-6 px-4 actions\\\">\\n                  <button\\n                    onClick={() => handleEdit(product)}\\n                    className=\\\"mr-2 rounded-lg border border-zinc-700 bg-zinc-950/50 px-3 py-2 text-sm text-zinc-400 hover:bg-zinc-900 transition-colors\\\"\\n                    aria-label=\\\"Edit product\\\"\\n                  >\\n                    Edit\\n                  </button>\\n                  <button\\n                    onClick={() => handleDelete(product.id)}\\n                    className=\\\"rounded-lg border border-zinc-700 bg-zinc-950/50 px-3 py-2 text-sm text-zinc-400 hover:bg-zinc-900 transition-colors\\\"\\n                    aria-label=\\\"Delete product\\\"\\n                  >\\n                    Delete\\n                  </button>\\n                </td>\\n              </tr>\\n            );\\n          })}\\n        </tbody>\\n      </table>\\n    </div>\\n  );\\n}\\nENDFILE\"]" cwd=/home/sleeky3750/pulse-web http.span=12239400 role=server
