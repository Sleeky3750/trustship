timestamp=2026-10-07T06:55:23.474Z level=INFO run=bd475466 message="spawning process" command=/bin/bash args="[\"-c\",\"set -e\\ncp prisma/schema.prisma /tmp/opencode/pre-aijob.prisma\\npython3 - <<'EOF'\\np='prisma/schema.prisma'\\ns=open(p).read()\\nold='''  knowledgeEntries    KnowledgeEntry[]\\n}'''\\nassert s.count(old)==1\\ns=s.replace(old,'''  knowledgeEntries    KnowledgeEntry[]\\n  aiJobs              AIJob[]\\n}''')\\ns += '''\\n// LEGACY: created by migration 20260811005337_add_ai_jobs for the removed\\n// project-planning AI. Nothing reads or writes it any more. It's declared here\\n// only so the schema matches the database and `prisma migrate dev` doesn't\\n// generate a DROP. Remove it with a deliberate migration once its data is no\\n// longer needed.\\nenum AIJobType {\\n  PROJECT_PLANNING\\n  TASK_ANALYSIS\\n  RESEARCH\\n  PROGRESS_ANALYSIS\\n  ASSISTANT\\n}\\n\\nenum AIJobStatus {\\n  QUEUED\\n  PROCESSING\\n  COMPLETED\\n  FAILED\\n}\\n\\nmodel AIJob {\\n  id          String      @id @default(cuid())\\n  businessId  String\\n  type        AIJobType\\n  status      AIJobStatus @default(QUEUED)\\n  input       Json\\n  output      Json?\\n  error       String?\\n  attempts    Int         @default(0)\\n  createdAt   DateTime    @default(now())\\n  startedAt   DateTime?\\n  completedAt DateTime?\\n\\n  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)\\n\\n  @@index([businessId])\\n  @@index([status])\\n  @@index([type])\\n  @@index([createdAt])\\n}\\n'''\\nopen(p,'w').write(s)\\nEOF\\nnpx prisma format >/dev/null 2>&1\\nnpx prisma migrate diff --from-schema-datamodel /tmp/opencode/pre-aijob.prisma --to-schema-datamodel prisma/schema.prisma --script 2>/dev/null > /tmp/opencode/aijob.sql\\nnorm() { grep -v '^--' \\\"$1\\\" | tr -s ' \\\\n' ' ' ; }\\ndiff <(norm /tmp/opencode/aijob.sql) <(norm prisma/migrations/20260811005337_add_ai_jobs/migration.sql) && echo \\\"IDENTICAL: schema now matches the AIJob migration exactly\\\"\"]" cwd=/home/sleeky3750/pulse-web http.span=4348525 role=server
